@using HolyPOS.Components.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">HolyPOS</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">

    <AuthorizeView Roles="Admin">
        <Authorized>
            <button onclick="window.location.href='/users/pos';" type="button"
                    class="btn btn-success btn-lg justify-content-between align-items-center">POS</button>
            <AdminNavMenu></AdminNavMenu>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="User">
        <Authorized>
            <UserNavMenu></UserNavMenu>
        </Authorized>
    </AuthorizeView>

        @if (HasUser)
        {
            <button @onclick="Logout" type="button"
                    class="btn btn-danger btn-lg align-self-end mr-3">Logout</button>
        }

    </nav>
</div>

@code{
    public bool HasUser = false;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthStateChanged;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        HasUser = authState.User.Identity is { IsAuthenticated: true };
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;
        HasUser = authState.User.Identity is { IsAuthenticated: true };
        InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        var authProvider =
                (CustomAuthStateProvider)
                AuthenticationStateProvider;

        await authProvider.Logout();

        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}