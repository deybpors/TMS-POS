@using HolyPOS.Components.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">HolyPOS</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="flex-column">

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-item px-3">
                    <!-- POS -->
                        <button @onclick="GoToPOS"
                                type="button"
                                class="btn btn-success btn-lg w-100 text-start px-4 py-2 rounded-0 mt-auto">
                            POS
                        </button>
                </div>

                <MyNavMenu Prefix="/admin/" />

            </Authorized>
        </AuthorizeView>

        <AuthorizeView Roles="User">
            <Authorized>
                <MyNavMenu Prefix="/users/" />
            </Authorized>
        </AuthorizeView>

        @if (HasUser)
        {
            
            <div class="nav-item px-3">
                <!-- Logout -->
                <button @onclick="Logout"
                        type="button"
                        class="btn btn-danger btn-lg w-100 text-start px-4 py-2 rounded-0 mt-auto">
                    Logout
                </button>
            </div>
        }

    </nav>
</div>

@code {
    public bool HasUser = false;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthStateChanged;

        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        HasUser = authState.User.Identity is { IsAuthenticated: true };
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> task)
    {
        var authState = await task;

        HasUser = authState.User.Identity is { IsAuthenticated: true };

        await InvokeAsync(StateHasChanged);
    }

    private void GoToPOS()
    {
        Navigation.NavigateTo("/users/pos");
    }

    private async Task Logout()
    {
        var authProvider =
            (CustomAuthStateProvider)AuthenticationStateProvider;

        await authProvider.Logout();

        Navigation.NavigateTo("/login");
    }

    public void Dispose()
    {
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }
}