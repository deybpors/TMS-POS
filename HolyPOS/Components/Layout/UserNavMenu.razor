@using System.Reflection
@using Microsoft.AspNetCore.Components

@foreach (var navPage in myUserPage)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="@navPage.Route">
            <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span>
            @navPage.Name
        </NavLink>
    </div>
}

@code {
    private List<UserPage> myUserPage = new List<UserPage>();

    protected override void OnInitialized()
    {
        myUserPage = Assembly.GetExecutingAssembly()
            .GetTypes()
            .Where(type => !type.IsAbstract)
            .SelectMany(type => type.GetCustomAttributes<RouteAttribute>()
                .Select(route => new UserPage
                {
                    Route = route.Template,
                    Name = GetPageName(route.Template)
                }))
            .Where(page => page.Route.StartsWith("/users/"))
            .Where(page => page.Route.Trim('/').Split('/').Length == 2)
            .OrderBy(page => page.Name)
            .ToList();
    }

    private static string GetPageName(string route)
    {
        var name = route
            .Trim('/')
            .Split('/')
            .LastOrDefault();

        if (string.IsNullOrWhiteSpace(name))
            return "Home";

        return string.Join(" ",
            name.Split('-', StringSplitOptions.RemoveEmptyEntries)
                .Select(word => char.ToUpper(word[0]) + word[1..]));
    }

    private class UserPage
    {
        public string Route { get; set; } = "";
        public string Name { get; set; } = "";
    }
}