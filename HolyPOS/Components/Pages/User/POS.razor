    protected override async Task OnInitializedAsync()
    {
        System.Random random = new();
        OrderNumber = random.Next(0, int.MaxValue);
        IsLoading = true;
        ErrorMessage = "";

        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthStateChanged;
        
        try
        {
            await Data.LoadAllAsync();

            await ResolveCurrentStoreAsync();

            if (CurrentStore is null)
            {
                ErrorMessage = "No active store was found.";
                return;
            }

            SelectDefaultPaymentType();
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"Failed to load the POS: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
    
