    private IEnumerable<Product> StoreProducts
    {
        get
        {
            if (CurrentStoreId is null)
                return Enumerable.Empty<Product>();


            var storeProductIds =
                Data.ProductStores
                    .Where(x =>
                        x.StoreId == CurrentStoreId.Value &&
                        x.IsActive)
                    .Select(x => x.ProductId)
                    .ToHashSet();


            return Data.Products
                .Where(x =>
                    x.IsActive &&
                    storeProductIds.Contains(x.Id));
        }
    }


    private IEnumerable<Product> FilteredProducts
    {
        get
        {
            IEnumerable<Product> result =
                StoreProducts;


            // CATEGORY
            if (SelectedCategoryId.HasValue)
            {
                result =
                    result.Where(x =>
                        x.CategoryId ==
                        SelectedCategoryId.Value);
            }


            // SEARCH
            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                string search =
                    SearchText.Trim();

                result =
                    result.Where(x =>
                        x.Name.Contains(
                            search,
                            StringComparison.OrdinalIgnoreCase));
            }


            // =====================================================
            // MOST SOLD → LEAST SOLD
            // =====================================================

            var salesByProduct =
                Data.TransactionItems
                    .Where(x => x.ProductId.HasValue)
                    .GroupBy(x => x.ProductId!.Value)
                    .ToDictionary(
                        x => x.Key,
                        x => x.Sum(item => item.Quantity)
                    );


            return result
                .OrderByDescending(x =>
                    salesByProduct.TryGetValue(
                        x.Id,
                        out var quantity)
                        ? quantity
                        : 0)
                .ThenBy(x => x.Name);
        }
    }


    private decimal GetProductPrice(Product product)
    {
        if (CurrentStoreId is null)
            return product.Price;


        var storeProduct =
            Data.ProductStores.FirstOrDefault(
                x =>
                    x.ProductId == product.Id &&
                    x.StoreId == CurrentStoreId.Value &&
                    x.IsActive);


        return storeProduct?.PriceOverride
            ?? product.Price;
    }


