    private decimal GetPendingDiscountAmount()
    {
        if (DiscountTargetItem is null)
            return 0m;

        var discount =
            PendingDiscountId is null
                ? null
                : Data.Discounts
                    .FirstOrDefault(x => x.Id == PendingDiscountId.Value);

