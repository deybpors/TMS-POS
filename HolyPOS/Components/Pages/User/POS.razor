    private void ProductClicked(Product product)
    {
        var modifiers =
            GetProductModifiers(product);


        if (!modifiers.Any())
        {
            AddProductToCart(
                product,
                new List<SelectedModifier>());

            return;
        }


        SelectedModifierProduct = product;

        SelectedProductModifiers = modifiers;

        SelectedModifierOptions =
            new Dictionary<Guid, HashSet<Guid>>();


        foreach (var modifier in modifiers)
        {
            SelectedModifierOptions[modifier.Id] =
                new HashSet<Guid>();
        }


        ShowModifierModal = true;
    }


