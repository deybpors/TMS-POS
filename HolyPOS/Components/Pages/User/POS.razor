    private void AddProductToCart(
        Product product,
        List<SelectedModifier> modifiers)
    {
        decimal unitPrice =
            GetProductPrice(product)
            +
            modifiers.Sum(x => x.Price);


        var existing =
            Cart.FirstOrDefault(
                x =>
                    x.Product.Id == product.Id &&
                    AreModifiersEqual(
                        x.SelectedModifiers,
                        modifiers));


        if (existing is not null)
        {
            existing.Quantity++;

            return;
        }


        Cart.Add(
            new CartItem
            {
                Product = product,

                Quantity = 1,

                UnitPrice = unitPrice,

                SelectedModifiers =
                    modifiers
            });
    }


    private bool AreModifiersEqual(
        List<SelectedModifier> first,
        List<SelectedModifier> second)
    {
        if (first.Count != second.Count)
            return false;


        var firstIds =
            first
                .Select(x => x.OptionId)
                .OrderBy(x => x)
                .ToList();


        var secondIds =
            second
                .Select(x => x.OptionId)
                .OrderBy(x => x)
                .ToList();


        return firstIds.SequenceEqual(secondIds);
    }


