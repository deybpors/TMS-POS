    private bool IsOptionSelected(
        Guid modifierId,
        Guid optionId)
    {
        return
            SelectedModifierOptions.TryGetValue(
                modifierId,
                out var selected)
            &&
            selected.Contains(optionId);
    }


    private void SelectModifierOption(
        Guid modifierId,
        Guid optionId)
    {
        if (!SelectedModifierOptions
            .TryGetValue(
                modifierId,
                out var selected))
        {
            selected =
                new HashSet<Guid>();

            SelectedModifierOptions[modifierId] =
                selected;
        }


        selected.Clear();

        selected.Add(optionId);
    }


    private void ToggleModifierOption(
        Guid modifierId,
        Guid optionId)
    {
        if (!SelectedModifierOptions
            .TryGetValue(
                modifierId,
                out var selected))
        {
            selected =
                new HashSet<Guid>();

            SelectedModifierOptions[modifierId] =
                selected;
        }


        if (selected.Contains(optionId))
        {
            selected.Remove(optionId);
        }
        else
        {
            selected.Add(optionId);
        }
    }


    // =========================================================
    // MODIFIER TOTAL
    // =========================================================

    private IEnumerable<SelectedModifier> SelectedModifiers
    {
        get
        {
            foreach (var modifier in SelectedProductModifiers)
            {
                if (!SelectedModifierOptions
                    .TryGetValue(
                        modifier.Id,
                        out var optionIds))
                {
                    continue;
                }


                foreach (var optionId in optionIds)
                {
                    var option =
                        Data.ModifierOptions.FirstOrDefault(
                            x =>
                                x.Id == optionId &&
                                x.ModifierId == modifier.Id);


                    if (option is null)
                        continue;


                    yield return new SelectedModifier
                    {
                        ModifierId = modifier.Id,
                        ModifierName = modifier.Name,
                        OptionId = option.Id,
                        OptionName = option.Name,
                        Price = option.Price
                    };
                }
            }
        }
    }


