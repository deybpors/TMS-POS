    private string GetDiscountLabel(Discount discount)
    {
        var type = discount.DiscountType.ToString() ?? "";

        if (type.Equals("percentage", StringComparison.OrdinalIgnoreCase))
        {
            return $"{discount.Value.ToString("N0")}%";
        }

        if (type.Equals("fixed_amount", StringComparison.OrdinalIgnoreCase))
        {
            return $"-₱{discount.Value.ToString("N2")}";
        }

        return "";
    }


    private decimal GetDiscountAmount(Discount? discount, decimal baseAmount)
    {
        if (discount is null)
            return 0m;

        var type = discount.DiscountType.ToString() ?? "";

        decimal amount;

        if (type.Equals("percentage", StringComparison.OrdinalIgnoreCase))
        {
            amount = baseAmount * (discount.Value / 100m);
        }
        else if (type.Equals("fixed_amount", StringComparison.OrdinalIgnoreCase))
        {
            amount = discount.Value;
        }
        else
        {
            amount = 0m;
        }

        // Never allow the discount to exceed this item's total.
        return Math.Clamp(amount, 0m, baseAmount);
    }


    private decimal Change =>
        Math.Max(
            0,
            CashReceived - Total);


    private bool CanCompletePayment
    {
        get
        {
            if (SelectedPaymentType is null)
                return false;


            if (SelectedPaymentType.IsCash)
            {
                return CashReceived >= Total;
            }


            return true;
        }
    }


    // =========================================================
    // COMPLETE PAYMENT
    // =========================================================

    private async Task CompletePayment()
{
    if (!CanCompletePayment)
        return;

    if (CurrentStoreId is null)
    {
        ErrorMessage =
            "No store is assigned to this cashier.";

        return;
    }

    if (SelectedPaymentType is null)
        return;

    if (!Cart.Any())
        return;

    ErrorMessage = "";

    try
    {
        // =========================================================
        // CREATE TRANSACTION
        // =========================================================

        var transaction =
            new Transaction
            {
                Id = Guid.NewGuid(),

                ReceiptId =
                    $"{OrderNumber}",

                StoreId =
                    CurrentStoreId.Value,

                TransactionDate =
                    DateTime.UtcNow,

                GrossSales =
                    Subtotal,

                Refunds =
                    0,

                Discounts =
                    Discount,

                NetSales =
                    Total,

                Cost =
                    0,

                GrossProfit =
                    Total,

                Type = Transaction.TransactionType.Sale,

                OriginalTransactionId =
                    null
            };


        // =========================================================
        // SAVE TRANSACTION
        // =========================================================

        var savedTransaction =
            await Data.SaveTransactionAsync(
                transaction);


        // =========================================================
        // SAVE TRANSACTION ITEMS
        // =========================================================

        foreach (var cartItem in Cart)
        {
            var product =
                cartItem.Product;


            var transactionItem =
                new TransactionItem
                {
                    Id =
                        Guid.NewGuid(),

                    TransactionId =
                        savedTransaction.Id,

                    ProductId =
                        product.Id,

                    Quantity =
                        cartItem.Quantity,

                    DiscountId =
                        cartItem.Discount?.Id
                };


            // -----------------------------------------------------
            // SAVE ITEM
            // -----------------------------------------------------

            var savedItem =
                await Data.SaveTransactionItemAsync(
                    transactionItem);


            Data.TransactionItems.Add(
                savedItem);


            // =====================================================
            // SAVE SELECTED MODIFIERS
            // =====================================================

            foreach (var modifier in cartItem.SelectedModifiers)
            {
                var transactionItemModifier =
                    new TransactionItemModifier
                    {
                        Id =
                            Guid.NewGuid(),

                        TransactionItemId =
                            savedItem.Id,

                        ModifierId =
                            modifier.ModifierId,

                        OptionId =
                            modifier.OptionId
                    };


                var savedModifier =
                    await Data.SaveTransactionItemModifierAsync(
                        transactionItemModifier);


                Data.TransactionItemModifiers.Add(
                    savedModifier);
            }
        }


        // =========================================================
        // SAVE PAYMENT
        // =========================================================

        var payment =
            new TransactionPayment
            {
                Id =
                    Guid.NewGuid(),

                TransactionId =
                    savedTransaction.Id,

                PaymentTypeId =
                    SelectedPaymentType.Id,

                Amount =
                    Total,

                CashReceived =
                    SelectedPaymentType.IsCash
                        ? CashReceived
                        : 0,

                ChangeAmount =
                    SelectedPaymentType.IsCash
                        ? Change
                        : 0
            };


        var savedPayment =
            await Data.SaveTransactionPaymentAsync(
                payment);


        // =========================================================
        // UPDATE LOCAL CACHE
        // =========================================================

        Data.Transactions.Add(
            savedTransaction);

        Data.TransactionPayments.Add(
            savedPayment);

        if (!string.IsNullOrWhiteSpace(SelectedPrinterName))
        {
            PrintReceipt(SelectedPrinterName);
        }

        // =========================================================
        // RESET POS
        // =========================================================

        Cart.Clear();

        System.Random random = new();
        OrderNumber = random.Next(0, int.MaxValue);

        ShowPaymentModal = false;

        SelectedPaymentTypeId = null;

        SelectedPaymentType = null;

        CashReceived = 0;
    }
    catch (Exception ex)
    {
        ErrorMessage =
            $"Failed to complete payment: {ex.Message}";
    }
}

    // LOCAL CART MODELS
    // =========================================================

    private class CartItem
    {
        public Product Product { get; set; } = null!;

        public int Quantity { get; set; }

        public decimal UnitPrice { get; set; }

        public List<SelectedModifier> SelectedModifiers { get; set; }
            = new();

        public Discount? Discount { get; set; }
    }


    private class SelectedModifier
    {
        public Guid ModifierId { get; set; }

        public string ModifierName { get; set; } = "";

        public Guid OptionId { get; set; }

        public string OptionName { get; set; } = "";

        public decimal Price { get; set; }
    }
    
    private string SelectedPrinterName = "";

    private List<string> AvailablePrinters =>
        PrinterSettings.InstalledPrinters
            .Cast<string>()
            .OrderBy(x => x)
            .ToList();
}