    private void CloseModal()
    {
        Selected = null;

        ErrorMessage = "";
    }


    // =========================================================
    // REFUND
    // =========================================================

    private async Task RefundTransaction()
    {
        if (Selected is null)
            return;

        if (Selected.Transaction.IsRefunded)
            return;

        IsRefunding = true;
        ErrorMessage = "";

        try
        {
    // ============================================
    // SAVE TO SUPABASE
    // ============================================

            await Data.MarkTransactionRefundedAsync(
                Selected.Transaction.Id);


    // ============================================
    // UPDATE LOCAL TRANSACTION
    // ============================================

            Selected.Transaction.IsRefunded = true;


            var transaction =
                Data.Transactions.FirstOrDefault(
                    x => x.Id == Selected.Transaction.Id);

            if (transaction is not null)
            {
                transaction.IsRefunded = true;
            }


    // ============================================
    // CLOSE MODAL
    // ============================================

            Selected = null;


    // ============================================
    // REBUILD TABLE
    // ============================================

            BuildTransactions();

            CurrentPage = 1;


    // Force Blazor to render the changes
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            ErrorMessage =
                $"Failed to refund transaction: {ex.Message}";
        }
        finally
        {
            IsRefunding = false;

            await InvokeAsync(StateHasChanged);
        }
    }


