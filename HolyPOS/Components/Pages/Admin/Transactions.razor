@page "/admin/transactions"
@page "/users/transactions"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using HolyPOS.Components.Models
@using HolyPOS.Components.Services
@using HolyPOS.Components.Layout

@inject DatabaseData Data

<PageTitle>Transactions</PageTitle>

<div class="admin-page">

    <!-- ===================================================== -->
    <!-- HEADER -->
    <!-- ===================================================== -->

    <div class="page-header">
        <div>
            <h1>Transactions</h1>
            <p>View your sales and transaction history.</p>
        </div>
    </div>


    <!-- ===================================================== -->
    <!-- FILTERS -->
    <!-- ===================================================== -->

    <div class="admin-card mb-4">
        <div class="p-4">
            <div class="row g-3 align-items-end">

                <DateRangePicker
                    StartDate="@DateFrom"
                    EndDate="@DateTo"
                    OnDateRangeChanged="DateRangeChanged" />

                <!-- STORE -->
                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <div class="col-md-2">
                            <label class="form-label text-muted small">Store</label>
                            <select class="form-select" @bind="SelectedStore" @bind:after="FiltersChanged">
                                <option value="">All stores</option>
                                @foreach (var store in Data.Stores.Where(x => x.Active).OrderBy(x => x.Name))
                                {
                                    <option value="@store.Id">@store.Name</option>
                                }
                            </select>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <!-- TYPE -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">Type</label>
                    <select class="form-select" @bind="SelectedType" @bind:after="FiltersChanged">
                        <option value="">All transactions</option>
                        <option value="sale">Sales</option>
                        <option value="refund">Refunds</option>
                        <option value="edited">Edited</option>
                    </select>
                </div>

                <!-- TIME -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">Time</label>
                    <select class="form-select" @bind="SelectedTime" @bind:after="FiltersChanged">
                        <option value="All day">All day</option>
                        <option value="Morning">Morning</option>
                        <option value="Afternoon">Afternoon</option>
                        <option value="Evening">Evening</option>
                    </select>
                </div>

                <!-- SEARCH -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">Search</label>
                    <input type="search" class="form-control" placeholder="Receipt, store, item..." @bind="Search" @bind:event="oninput" @bind:after="FiltersChanged" />
                </div>
            </div>
        </div>
    </div>


    <!-- ===================================================== -->
    <!-- SUMMARY -->
    <!-- ===================================================== -->

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="admin-card p-4">
                <div class="text-muted small">Sales</div>
                <div class="fs-3 fw-semibold">@SalesCount</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="admin-card p-4">
                <div class="text-muted small">Refunds</div>
                <div class="fs-3 fw-semibold">@RefundCount</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="admin-card p-4">
                <div class="text-muted small">Net Sales</div>
                <div class="fs-3 fw-semibold">₱@NetSales.ToString("N2")</div>
            </div>
        </div>
    </div>


    <!-- ===================================================== -->
    <!-- TABLE -->
    <!-- ===================================================== -->

    <div class="admin-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="px-4">Receipt ID</th>
                        <th>Date</th>
                        <th>Store</th>
                        <th>Type</th>
                        <th>Gross</th>
                        <th>Discount</th>
                        <th>Net</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5">
                                <div class="spinner-border" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </td>
                        </tr>
                    }
                    else if (!PagedTransactions.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-5">No transactions found.</td></tr>
                    }
                    else
                    {
                        @foreach (var row in PagedTransactions)
                        {
                            var transaction = row.Transaction;
                            var totals = CalculateTransactionTotals(row);

                            <tr>
                                <td class="px-4">
                                    <button type="button" class="btn btn-link text-dark text-decoration-none p-0" @onclick="() => ViewTransaction(row)">
                                        @transaction.ReceiptId
                                    </button>
                                </td>
                                <td>
                                    <div>@(transaction.TransactionDate.ToLocalTime().ToString("MMM dd, yyyy"))</div>
                                    <small class="text-muted">@(transaction.TransactionDate.ToLocalTime().ToString("h:mm tt"))</small>
                                </td>
                                <td>@row.StoreName</td>
                                <td>
                                    <span class="badge @GetTypeBadgeClass(transaction.Type)">@GetTypeLabel(transaction.Type)</span>
                                    @if (IsSuperseded(transaction))
                                    {
                                        <small class="text-muted d-block">Superseded</small>
                                    }
                                </td>
                                <td>₱@totals.Gross.ToString("N2")</td>
                                <td>₱@totals.Discount.ToString("N2")</td>
                                <td>
                                    @if (transaction.Type == Transaction.TransactionType.Refunded)
                                    {
                                        <span class="text-danger">-₱@transaction.Refunds.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span>₱@totals.Net.ToString("N2")</span>
                                    }
                                </td>
                                <td class="text-end px-4">
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ViewTransaction(row)">View</button>
                                        @if (CanEditTransaction(transaction))
                                        {
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => OpenEditModal(row)">Edit</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex align-items-center p-3 border-top">
            <div class="btn-group">
                <button type="button" class="btn btn-outline-secondary" disabled="@(!HasPreviousPage)" @onclick="PreviousPage"><i class="bi bi-chevron-left"></i></button>
                <button type="button" class="btn btn-outline-secondary" disabled="@(!HasNextPage)" @onclick="NextPage"><i class="bi bi-chevron-right"></i></button>
            </div>
            <div class="ms-4 d-flex align-items-center gap-2">
                <span>Page:</span>
                <span class="fw-semibold">@CurrentPage</span>
                <span>of @TotalPages</span>
                <span class="ms-4">Rows per page:</span>
                <select class="form-select" style="width:90px;" @bind="RowsPerPage" @bind:after="RowsPerPageChanged">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>
    </div>
</div>


<!-- ========================================================= -->
<!-- TRANSACTION DETAILS MODAL -->
<!-- ========================================================= -->

@if (Selected is not null)
{
    var totals = CalculateTransactionTotals(Selected);

    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1040;">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">Receipt @Selected.Transaction.ReceiptId</h5>
                        <small class="text-muted">@(Selected.Transaction.TransactionDate.ToLocalTime().ToString("MMM dd, yyyy h:mm tt"))</small>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="text-muted small">Receipt</div>
                            <div class="fw-semibold">@Selected.Transaction.ReceiptId</div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted small">Store</div>
                            <div class="fw-semibold">@Selected.StoreName</div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-muted small">Type</div>
                            <div><span class="badge @GetTypeBadgeClass(Selected.Transaction.Type)">@GetTypeLabel(Selected.Transaction.Type)</span></div>
                        </div>
                    </div>

                    @if (Selected.Transaction.OriginalTransactionId.HasValue)
                    {
                        <div class="alert alert-warning">
                            @if (Selected.Transaction.Type == Transaction.TransactionType.Refunded)
                            {
                                <text>This transaction is a refund of another transaction.</text>
                            }
                            else
                            {
                                <text>This transaction is an edited version of another transaction.</text>
                            }
                        </div>
                    }

                    <h6 class="mb-3">Items</h6>
                    @if (!Selected.Items.Any())
                    {
                        <div class="text-muted mb-4">No transaction items found.</div>
                    }
                    else
                    {
                        <div class="border rounded">
                            @foreach (var item in Selected.Items)
                            {
                                var itemCalculation = CalculateItemTotal(item);
                                <div class="p-3 border-bottom">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <div class="fw-semibold">@Data.Products.FirstOrDefault(x => x.Id == item.ProductId)?.Name</div>
                                            <small class="text-muted d-block">@item.Quantity × ₱@Data.GetItemUnitPrice(item).ToString("N2")</small>
                                            @if (itemCalculation.DiscountAmount > 0)
                                            {
                                                <small class="text-danger d-block">
                                                    @if (itemCalculation.Discount is not null)
                                                    {
                                                        @itemCalculation.Discount.Name <span>—</span>
                                                    }
                                                    -₱@itemCalculation.DiscountAmount.ToString("N2")
                                                </small>
                                            }
                                        </div>
                                        <div class="text-end">
                                            <div class="fw-semibold">₱@itemCalculation.Total.ToString("N2")</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <div class="mt-4">
                        <div class="d-flex justify-content-between mb-2"><span>Gross Sales</span><span>₱@totals.Gross.ToString("N2")</span></div>
                        <div class="d-flex justify-content-between mb-2"><span>Discounts</span><span>₱@totals.Discount.ToString("N2")</span></div>
                        @if (Selected.Transaction.Refunds > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-danger"><span>Refunds</span><span>-₱@Selected.Transaction.Refunds.ToString("N2")</span></div>
                        }
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5"><span>Net Sales</span><span>₱@totals.Net.ToString("N2")</span></div>
                    </div>
                </div>

                <div class="modal-footer justify-content-between">
                    <div class="d-flex gap-2">
                        @if (CanEditTransaction(Selected.Transaction))
                        {
                            <button type="button" class="btn btn-outline-primary" @onclick="() => OpenEditModal(Selected)" disabled="@IsRefunding"><i class="bi bi-pencil me-1"></i><span>EDIT</span></button>
                        }

                        @if (Selected.Transaction.Type != Transaction.TransactionType.Refunded && !IsSuperseded(Selected.Transaction))
                        {
                            <AuthorizeView Roles="Admin">
                                <Authorized>
                                    <button type="button" class="btn btn-outline-danger" @onclick="RefundTransaction" disabled="@IsRefunding">
                                        @if (IsRefunding)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span><span>REFUNDING...</span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-arrow-counterclockwise me-1"></i><span>REFUND</span>
                                        }
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        }
                    </div>
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal" disabled="@IsRefunding">CLOSE</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show" style="z-index: 1030;"></div>
}


<!-- ========================================================= -->
<!-- EDIT TRANSACTION MODAL (ONE-PAGE POS LAYOUT) -->
<!-- ========================================================= -->

@if (ShowEditModal && EditingRow is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,.5); z-index: 1050;">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content h-100">
                <div class="modal-header bg-dark text-white border-bottom-0 py-2">
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseEditModal" disabled="@IsSavingEdit"></button>
                </div>
                <div class="modal-body p-0 d-flex flex-column h-100 bg-light">
                    
                    <div class="flex-grow-1 d-flex overflow-hidden">
                        
                        <!-- LEFT: PRODUCTS -->
                        <div class="flex-grow-1 d-flex flex-column overflow-hidden">
                            <div class="bg-white border-bottom p-3">
                                <div class="d-flex align-items-center justify-content-between gap-3">
                                    <div class="flex-grow-1">
                                        <h4 class="mb-0">Edit Order</h4>
                                        <small class="text-muted">
                                            @EditingRow.StoreName · Receipt @EditingRow.Transaction.ReceiptId
                                        </small>
                                    </div>
                                    <div style="width: 200px;">
                                        <select class="form-select" @bind="SelectedCategoryId">
                                            <option value="">All Categories</option>
                                            @foreach (var category in ActiveCategories)
                                            {
                                                <option value="@category.Id">@GetCategoryIcon(category.Name) @category.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="input-group" style="max-width:400px;">
                                        <span class="input-group-text bg-white">🔍</span>
                                        <input type="text" class="form-control" placeholder="Search products..." @bind="SearchText" @bind:event="oninput" />
                                        @if (!string.IsNullOrWhiteSpace(SearchText))
                                        {
                                            <button type="button" class="btn btn-outline-secondary" @onclick="ClearSearch">×</button>
                                        }
                                    </div>
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrWhiteSpace(EditErrorMessage))
                            {
                                <div class="alert alert-danger rounded-0 mb-0">@EditErrorMessage</div>
                            }

                            <!-- PRODUCT GRID -->
                            <div class="flex-grow-1 overflow-auto p-3">
                                <div class="row g-3">
                                    @foreach (var product in FilteredProducts)
                                    {
                                        <div class="col-6 col-md-4 col-xl-3 col-xxl-2">
                                            <button type="button" class="btn p-0 w-100 h-100 text-start border rounded-3 bg-white shadow-sm overflow-hidden d-flex flex-column" @onclick="() => ProductClicked(product)">
                                                <div class="bg-light d-flex align-items-center justify-content-center flex-shrink-0" style="height:120px;">
                                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                                    {
                                                        <img src="@product.ImageUrl" alt="@product.Name" class="w-100 h-100" style="object-fit:cover;" />
                                                    }
                                                    else
                                                    {
                                                        <span class="fs-1">🍵</span>
                                                    }
                                                </div>
                                                <div class="p-3 d-flex flex-column flex-grow-1">
                                                    <div class="fw-normal text-center text-dark">@product.Name</div>
                                                    <div class="mt-auto pt-3 text-center">
                                                        <span class="fw-bold fs-5 text-success">₱@GetProductPrice(product).ToString("N2")</span>
                                                    </div>
                                                </div>
                                            </button>
                                        </div>
                                    }
                                </div>
                                @if (!FilteredProducts.Any())
                                {
                                    <div class="h-100 d-flex align-items-center justify-content-center">
                                        <div class="text-center text-muted">
                                            <div class="fs-1 mb-3">🔍</div>
                                            <h5>No products found</h5>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- RIGHT: CURRENT ORDER & PAYMENT EMBEDDED -->
                        <div class="bg-white border-start d-flex flex-column shadow-sm" style="width:420px; min-width:420px;">
                            <div class="p-3 border-bottom bg-light">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-0">Edited Cart</h5>
                                        <small class="text-muted">@CartItemCount item(s)</small>
                                    </div>
                                    @if (Cart.Any())
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearCart">Clear</button>
                                    }
                                </div>
                            </div>

                            <!-- CART ITEMS -->
                            <div class="flex-grow-1 overflow-auto" style="max-height: 38vh;">
                                @if (!Cart.Any())
                                {
                                    <div class="h-100 d-flex align-items-center justify-content-center text-center p-4">
                                        <div>
                                            <div class="fs-1 mb-3">🛒</div>
                                            <h6>No items left</h6>
                                            <small class="text-muted">Select a product to add to the edited order.</small>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var item in Cart)
                                    {
                                        <div class="p-3 border-bottom">
                                            <div class="d-flex justify-content-between gap-2">
                                                <div class="flex-grow-1">
                                                    <div class="fw-semibold">@item.Product.Name</div>
                                                    @if (item.SelectedModifiers.Any())
                                                    {
                                                        <div class="mt-1">
                                                            @foreach (var modifier in item.SelectedModifiers)
                                                            {
                                                                <small class="text-muted d-block">
                                                                    @modifier.ModifierName: @modifier.OptionName
                                                                    @if (modifier.Price > 0)
                                                                    {
                                                                        <span>(+₱@modifier.Price.ToString("N2"))</span>
                                                                    }
                                                                </small>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                                <div class="text-muted">₱@item.UnitPrice.ToString("N2")</div>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center mt-2">
                                                <div class="btn-group">
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => DecreaseQuantity(item)">−</button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled>@item.Quantity</button>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => IncreaseQuantity(item)">+</button>
                                                </div>
                                                <div class="fw-bold">₱@((item.UnitPrice * item.Quantity).ToString("N2"))</div>
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center mt-2">
                                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none d-flex align-items-center gap-1" @onclick="() => OpenDiscountModal(item)">
                                                    🏷️
                                                    @if (item.Discount is not null)
                                                    {
                                                        <span class="badge bg-success-subtle text-success">@item.Discount.Name</span>
                                                    }
                                                    else
                                                    {
                                                        <small class="text-muted">Add discount</small>
                                                    }
                                                </button>
                                                @if (item.Discount is not null)
                                                {
                                                    <small class="text-success">-₱@GetItemDiscountAmount(item).ToString("N2")</small>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>

                            <!-- TOTALS & EMBEDDED PAYMENT SECTION -->
                            <div class="border-top p-3 bg-light overflow-auto" style="max-height: 48vh;">
                                <div class="d-flex justify-content-between mb-1"><span class="text-muted small">Subtotal</span><span>₱@Subtotal.ToString("N2")</span></div>
                                <div class="d-flex justify-content-between mb-1"><span class="text-muted small">Discount</span><span class="text-danger">-₱@Discount.ToString("N2")</span></div>
                                <div class="d-flex justify-content-between mb-2"><span class="text-muted small">Tax</span><span>₱@Tax.ToString("N2")</span></div>
                                <div class="d-flex justify-content-between border-top pt-2 mb-3">
                                    <span class="fw-bold">Net Total</span>
                                    <span class="fw-bold text-success fs-5">₱@Total.ToString("N2")</span>
                                </div>

                                <!-- Payment Options Embedded Directly -->
                                <div class="mb-2 fw-semibold small text-muted">Payment Type</div>
                                <div class="row g-2 mb-3">
                                    @foreach (var paymentType in ActivePaymentTypes)
                                    {
                                        <div class="col-6">
                                            <button type="button" class="btn btn-sm w-100 py-2 @(SelectedPaymentTypeId == paymentType.Id ? "btn-success" : "btn-outline-secondary")" @onclick="() => SelectPaymentType(paymentType)">
                                                <div>@GetPaymentIcon(paymentType.Name) @paymentType.Name</div>
                                            </button>
                                        </div>
                                    }
                                </div>

                                @if (SelectedPaymentType?.IsCash == true)
                                {
                                    <div class="mb-3">
                                        <label class="form-label small">Cash received</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">₱</span>
                                            <input type="number" class="form-control" step="0.01" min="0" placeholder="0.00" @bind="CashReceived" @bind:event="oninput" />
                                        </div>
                                        <div class="d-flex justify-content-between mt-1 small">
                                            <span>Change:</span>
                                            <strong class="text-success">₱@Change.ToString("N2")</strong>
                                        </div>
                                    </div>
                                }

                                <button type="button" class="btn btn-primary btn-lg w-100 d-flex justify-content-between align-items-center" disabled="@(!CanCompletePayment || !Cart.Any() || IsSavingEdit)" @onclick="SaveEdit">
                                    @if (IsSavingEdit)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span><span>SAVING...</span>
                                    }
                                    else
                                    {
                                        <span>Save Transaction Edit</span>
                                        <strong>₱@Total.ToString("N2")</strong>
                                    }
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- MODIFIERS MODAL -->
    @if (ShowModifierModal && SelectedModifierProduct is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,.6); z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title mb-0">@SelectedModifierProduct.Name</h5>
                            <small class="text-muted">Customize your order</small>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseModifierModal"></button>
                    </div>
                    <div class="modal-body">
                        @foreach (var modifier in SelectedProductModifiers)
                        {
                            var options = GetModifierOptions(modifier.Id);
                            if (options.Any())
                            {
                                <div class="mb-4">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div class="fw-semibold fs-5">@modifier.Name</div>
                                        @if (modifier.AllowMultiple) { <small class="text-muted">Multiple</small> }
                                        else { <small class="text-muted">Choose one</small> }
                                    </div>
                                    @foreach (var option in options)
                                    {
                                        <button type="button" class="btn w-100 text-start border rounded-3 mb-2 @(IsOptionSelected(modifier.Id, option.Id) ? "border-success bg-success-subtle" : "bg-white")" @onclick="() => { if (modifier.AllowMultiple) { ToggleModifierOption(modifier.Id, option.Id); } else { SelectModifierOption(modifier.Id, option.Id); } }">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div class="d-flex align-items-center gap-3">
                                                    @if(modifier.AllowMultiple) {
                                                        <input type="checkbox" class="form-check-input m-0" checked="@IsOptionSelected(modifier.Id, option.Id)" @onclick:stopPropagation />
                                                    } else {
                                                        <input type="radio" class="form-check-input m-0" name="modifier_@modifier.Id" checked="@IsOptionSelected(modifier.Id, option.Id)" @onclick:stopPropagation />
                                                    }
                                                    <span>@option.Name</span>
                                                </div>
                                                @if (option.Price > 0)
                                                {
                                                    <span class="text-success fw-semibold">+₱@option.Price.ToString("N2")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Included</span>
                                                }
                                            </div>
                                        </button>
                                    }
                                </div>
                            }
                        }
                        <div class="border-top pt-3">
                            <div class="d-flex justify-content-between"><span class="text-muted">Product</span><span>₱@GetProductPrice(SelectedModifierProduct).ToString("N2")</span></div>
                            <div class="d-flex justify-content-between"><span class="text-muted">Modifiers</span><span>₱@SelectedModifierTotal.ToString("N2")</span></div>
                            <div class="d-flex justify-content-between fs-5 fw-bold mt-2"><span>Total</span><span class="text-success">₱@ModifierGrandTotal.ToString("N2")</span></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseModifierModal">Cancel</button>
                        <button type="button" class="btn btn-success" @onclick="ConfirmModifierProduct">Add to order</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- DISCOUNT MODAL -->
    @if (ShowDiscountModal && DiscountTargetItem is not null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,.6); z-index: 1060;">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title mb-0">Apply Discount</h5>
                            <small class="text-muted">@DiscountTargetItem.Product.Name</small>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseDiscountModal"></button>
                    </div>
                    <div class="modal-body">
                        <button type="button" class="btn w-100 text-start border rounded-3 mb-2 @(PendingDiscountId is null ? "border-success bg-success-subtle" : "bg-white")" @onclick="() => PendingDiscountId = null">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3">
                                    <input type="radio" class="form-check-input m-0" name="discount_option" checked="@(PendingDiscountId is null)" @onclick:stopPropagation />
                                    <span>No discount</span>
                                </div>
                            </div>
                        </button>
                        @foreach (var discount in Data.Discounts)
                        {
                            <button type="button" class="btn w-100 text-start border rounded-3 mb-2 @(PendingDiscountId == discount.Id ? "border-success bg-success-subtle" : "bg-white")" @onclick="() => PendingDiscountId = discount.Id">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center gap-3">
                                        <input type="radio" class="form-check-input m-0" name="discount_option" checked="@(PendingDiscountId == discount.Id)" @onclick:stopPropagation />
                                        <span>@discount.Name</span>
                                    </div>
                                    <span class="text-success fw-semibold">@GetDiscountLabel(discount)</span>
                                </div>
                            </button>
                        }
                        <div class="border-top pt-3 mt-3">
                            <div class="d-flex justify-content-between"><span class="text-muted">Item total</span><span>₱@((DiscountTargetItem.UnitPrice * DiscountTargetItem.Quantity).ToString("N2"))</span></div>
                            <div class="d-flex justify-content-between fs-5 fw-bold mt-2"><span>Discount preview</span><span class="text-success">-₱@GetPendingDiscountAmount().ToString("N2")</span></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseDiscountModal">Cancel</button>
                        <button type="button" class="btn btn-success" @onclick="ApplyDiscount">Apply</button>
                    </div>
                </div>
            </div>
        </div>
    }
}


@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger position-fixed bottom-0 end-0 m-4" style="z-index: 2000; max-width:500px;">
        @ErrorMessage
    </div>
}

@code {
    // =========================================================
    // STATE
    // =========================================================
    private bool IsLoading;
    private bool IsRefunding;
    private string ErrorMessage = "";

    // ---------------------------------------------------------
    // FILTERS & PAGINATION
    // ---------------------------------------------------------
    private DateTime DateFrom = DateTime.Today.AddDays(-29);
    private DateTime DateTo = DateTime.Today;
    private string SelectedStore = "";
    private string SelectedTime = "All day";
    public string SelectedType = "";
    private string Search = "";
    private int CurrentPage = 1;
    private int RowsPerPage = 10;

    // ---------------------------------------------------------
    // DATA
    // ---------------------------------------------------------
    private List<TransactionRow> AllTransactions = new();
    private HashSet<Guid> SupersededTransactionIds = new();
    private TransactionRow? Selected;
    private const int DiscountTypePercentage = 0;
    private const int DiscountTypeAmount = 1;

    // ---------------------------------------------------------
    // EDIT (POS OVERHAUL) STATE
    // ---------------------------------------------------------
    private bool ShowEditModal;
    private TransactionRow? EditingRow;
    private Guid? EditStoreId;
    private bool IsSavingEdit;
    private string EditErrorMessage = "";

    private string SearchText = "";
    private Guid? SelectedCategoryId;
    private List<CartItem> Cart = new();

    // Modifiers State
    private bool ShowModifierModal;
    private Product? SelectedModifierProduct;
    private List<Modifier> SelectedProductModifiers = new();
    private Dictionary<Guid, HashSet<Guid>> SelectedModifierOptions = new();

    // Discount State
    private bool ShowDiscountModal;
    private CartItem? DiscountTargetItem;
    private Guid? PendingDiscountId;

    // Payment State (Embedded)
    private Guid? SelectedPaymentTypeId;
    private PaymentType? SelectedPaymentType;
    private decimal CashReceived;


    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            await Data.LoadAllAsync();
            BuildTransactions();
        }
        catch
        {
            AllTransactions = new();
        }
        finally
        {
            IsLoading = false;
        }
    }
private HashSet<Guid> TransactionsWithRefundedLatestReceipt = new();
    private void BuildTransactions()
    {
        SupersededTransactionIds = Data.Transactions
                .Where(x => x.Type == Transaction.TransactionType.Edited && x.OriginalTransactionId.HasValue)
                .Select(x => x.OriginalTransactionId!.Value)
                .ToHashSet();

        // Track receipts where the latest transaction in the chain is refunded
        TransactionsWithRefundedLatestReceipt = Data.Transactions
                .GroupBy(x => x.ReceiptId)
                .Where(g => 
                {
                    var latest = g.OrderByDescending(t => t.CreatedAt).ThenByDescending(t => t.TransactionDate).FirstOrDefault();
                    return latest != null && latest.Type == Transaction.TransactionType.Refunded;
                })
                .SelectMany(g => g.Select(t => t.Id))
                .ToHashSet();

        AllTransactions = Data.Transactions
                .Select(transaction =>
                {
                    var store = transaction.StoreId.HasValue ? Data.Stores.FirstOrDefault(x => x.Id == transaction.StoreId.Value) : null;
                    var items = Data.TransactionItems.Where(x => x.TransactionId == transaction.Id).ToList();
                    return new TransactionRow { Transaction = transaction, StoreName = store?.Name ?? "Unknown store", Items = items };
                })
                .OrderByDescending(x => x.Transaction.TransactionDate)
                .ToList();
    }

    private Discount? GetDiscount(TransactionItem item) => item.DiscountId.HasValue ? Data.Discounts.FirstOrDefault(x => x.Id == item.DiscountId.Value) : null;

    private ItemCalculation CalculateItemTotal(TransactionItem item)
    {
        decimal subtotal = Data.GetItemUnitPrice(item) * item.Quantity;
        Discount? discount = GetDiscount(item);
        if (discount is null) return new ItemCalculation { Subtotal = subtotal, DiscountAmount = 0, Total = subtotal, Discount = null };

        decimal discountAmount;
        int discountType = Convert.ToInt32(discount.DiscountType);
        if (discountType == DiscountTypePercentage) discountAmount = subtotal * (discount.Value / 100m);
        else if (discountType == DiscountTypeAmount) discountAmount = discount.Value;
        else discountAmount = 0;

        discountAmount = Math.Clamp(discountAmount, 0, subtotal);
        return new ItemCalculation { Subtotal = subtotal, DiscountAmount = discountAmount, Total = subtotal - discountAmount, Discount = discount };
    }

    private TransactionCalculation CalculateTransactionTotals(TransactionRow row)
    {
        decimal gross = 0; decimal discount = 0;
        foreach (var item in row.Items)
        {
            var calc = CalculateItemTotal(item);
            gross += calc.Subtotal; discount += calc.DiscountAmount;
        }
        return new TransactionCalculation { Gross = gross, Discount = discount, Net = gross - discount };
    }

    private IEnumerable<TransactionRow> FilteredTransactions
    {
        get
        {
            var result = AllTransactions.AsEnumerable();
            DateTime start = DateFrom.Date; DateTime end = DateTo.Date.AddDays(1);
            result = result.Where(x => x.Transaction.TransactionDate >= start && x.Transaction.TransactionDate < end);
            if (!string.IsNullOrWhiteSpace(SelectedStore) && Guid.TryParse(SelectedStore, out Guid storeId)) result = result.Where(x => x.Transaction.StoreId == storeId);
            if (SelectedType == "sale") result = result.Where(x => x.Transaction.Type == Transaction.TransactionType.Sale);
            else if (SelectedType == "refund") result = result.Where(x => x.Transaction.Type == Transaction.TransactionType.Refunded);
            else if (SelectedType == "edited") result = result.Where(x => x.Transaction.Type == Transaction.TransactionType.Edited);
            if (SelectedTime != "All day") result = result.Where(x => MatchesTime(x.Transaction.TransactionDate));
            if (!string.IsNullOrWhiteSpace(Search))
            {
                string s = Search.Trim();
                result = result.Where(x => x.Transaction.ReceiptId.Contains(s, StringComparison.OrdinalIgnoreCase) || x.StoreName.Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            return result.OrderByDescending(x => x.Transaction.TransactionDate);
        }
    }

    private IEnumerable<TransactionRow> PagedTransactions => FilteredTransactions.Skip((CurrentPage - 1) * RowsPerPage).Take(RowsPerPage);
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredTransactions.Count() / (double)RowsPerPage));
    private bool HasPreviousPage => CurrentPage > 1;
    private bool HasNextPage => CurrentPage < TotalPages;
    private void PreviousPage() { if (CurrentPage > 1) CurrentPage--; }
    private void NextPage() { if (CurrentPage < TotalPages) CurrentPage++; }
    private void RowsPerPageChanged() { CurrentPage = 1; }

    private int SalesCount => FilteredTransactions.Count(x => x.Transaction.Type != Transaction.TransactionType.Refunded && !IsSuperseded(x.Transaction));
    private int RefundCount => FilteredTransactions.Count(x => x.Transaction.Type == Transaction.TransactionType.Refunded);
    private decimal NetSales => FilteredTransactions.Sum(x => IsSuperseded(x.Transaction) ? 0 : (x.Transaction.Type == Transaction.TransactionType.Refunded ? -x.Transaction.Refunds : CalculateTransactionTotals(x).Net));

    private string GetTypeBadgeClass(Transaction.TransactionType type) => type switch { Transaction.TransactionType.Refunded => "bg-danger", Transaction.TransactionType.Edited => "bg-warning text-dark", _ => "bg-success" };
    private string GetTypeLabel(Transaction.TransactionType type) => type switch { Transaction.TransactionType.Refunded => "Refunded", Transaction.TransactionType.Edited => "Edited", _ => "Sale" };

    private bool CanEditTransaction(Transaction transaction)
    {
        if (transaction.Type == Transaction.TransactionType.Refunded) return false;
        if (IsSuperseded(transaction)) return false;
        if (TransactionsWithRefundedLatestReceipt.Contains(transaction.Id)) return false;
        return true;
    }
    private bool IsSuperseded(Transaction transaction) => SupersededTransactionIds.Contains(transaction.Id);

    private Task FiltersChanged() { CurrentPage = 1; BuildTransactions(); return Task.CompletedTask; }
    private async Task DateRangeChanged((DateTime Start, DateTime End) range) { DateFrom = range.Start; DateTo = range.End; CurrentPage = 1; await FiltersChanged(); }
    private bool MatchesTime(DateTime date)
    {
        TimeSpan time = date.ToLocalTime().TimeOfDay;
        return SelectedTime switch { "Morning" => time >= TimeSpan.FromHours(6) && time < TimeSpan.FromHours(12), "Afternoon" => time >= TimeSpan.FromHours(12) && time < TimeSpan.FromHours(18), "Evening" => time >= TimeSpan.FromHours(18) && time < TimeSpan.FromHours(24), _ => true };
    }

    private void ViewTransaction(TransactionRow row) { Selected = row; ErrorMessage = ""; }
    private void CloseModal() { Selected = null; ErrorMessage = ""; }

    // =========================================================
    // EDIT MODAL: POS INTEGRATION METHODS
    // =========================================================

    private void OpenEditModal(TransactionRow row)
    {
        if (!CanEditTransaction(row.Transaction)) return;
        EditingRow = row;
        EditStoreId = row.Transaction.StoreId;
        
        Cart.Clear();
        foreach (var item in row.Items)
        {
            var product = Data.Products.FirstOrDefault(p => p.Id == item.ProductId);
            if (product == null) continue;

            var itemMods = Data.TransactionItemModifiers.Where(m => m.TransactionItemId == item.Id).ToList();
            var selectedMods = itemMods.Select(m => {
                var mod = Data.Modifiers.FirstOrDefault(x => x.Id == m.ModifierId);
                var opt = Data.ModifierOptions.FirstOrDefault(x => x.Id == m.OptionId);
                if (mod == null || opt == null) return null;
                return new SelectedModifier { ModifierId = mod.Id, ModifierName = mod.Name, OptionId = opt.Id, OptionName = opt.Name, Price = opt.Price };
            }).Where(m => m != null).Select(m => m!).ToList();

            var discount = item.DiscountId.HasValue ? Data.Discounts.FirstOrDefault(d => d.Id == item.DiscountId) : null;
            decimal basePrice = GetProductPrice(product);
            decimal unitPrice = basePrice + selectedMods.Sum(x => x.Price);

            Cart.Add(new CartItem {
                Product = product,
                Quantity = (int)item.Quantity,
                UnitPrice = unitPrice,
                SelectedModifiers = selectedMods,
                Discount = discount
            });
        }
        
        // Auto-select original payment type or default
        var originalPayment = Data.TransactionPayments.FirstOrDefault(p => p.TransactionId == row.Transaction.Id);
        if (originalPayment != null)
        {
            var pType = ActivePaymentTypes.FirstOrDefault(pt => pt.Id == originalPayment.PaymentTypeId);
            if (pType != null) { SelectPaymentType(pType); CashReceived = originalPayment.CashReceived > 0 ? originalPayment.CashReceived : Total; }
            else SelectDefaultPaymentType();
        }
        else
        {
            SelectDefaultPaymentType();
        }
        
        SearchText = "";
        SelectedCategoryId = null;
        EditErrorMessage = "";
        ShowEditModal = true;
    }

    private void CloseEditModal()
    {
        if (IsSavingEdit) return;
        ShowEditModal = false;
        EditingRow = null;
        Cart.Clear();
    }

    // --- POS PRODUCT GRID ---
    private IEnumerable<Category> ActiveCategories => Data.Categories.Where(x => x.IsActive).OrderBy(x => x.Name);
    private string GetCategoryIcon(string categoryName) => categoryName.ToLowerInvariant() switch { var x when x.Contains("matcha") => "🍵", var x when x.Contains("coffee") => "☕", var x when x.Contains("drink") => "🥤", var x when x.Contains("non") => "🥤", var x when x.Contains("pastr") => "🥐", var x when x.Contains("food") => "🍱", _ => "•" };

    private IEnumerable<Product> StoreProducts
    {
        get
        {
            if (EditStoreId is null) return Enumerable.Empty<Product>();
            var storeProductIds = Data.ProductStores.Where(x => x.StoreId == EditStoreId.Value && x.IsActive).Select(x => x.ProductId).ToHashSet();
            return Data.Products.Where(x => x.IsActive && storeProductIds.Contains(x.Id));
        }
    }

    private IEnumerable<Product> FilteredProducts
    {
        get
        {
            var result = StoreProducts;
            if (SelectedCategoryId.HasValue) result = result.Where(x => x.CategoryId == SelectedCategoryId.Value);
            if (!string.IsNullOrWhiteSpace(SearchText)) result = result.Where(x => x.Name.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase));
            return result.OrderBy(x => x.Name);
        }
    }

    private decimal GetProductPrice(Product product)
    {
        if (EditStoreId is null) return product.Price;
        var storeProduct = Data.ProductStores.FirstOrDefault(x => x.ProductId == product.Id && x.StoreId == EditStoreId.Value && x.IsActive);
        return storeProduct?.PriceOverride ?? product.Price;
    }

    private void ClearSearch() { SearchText = ""; }

    // --- POS MODIFIERS ---
    private List<Modifier> GetProductModifiers(Product product)
    {
        var modifierIds = Data.ProductModifiers.Where(x => x.ProductId == product.Id).OrderBy(x => x.SortOrder).Select(x => x.ModifierId).ToList();
        return Data.Modifiers.Where(x => modifierIds.Contains(x.Id)).OrderBy(x => modifierIds.IndexOf(x.Id)).ToList();
    }
    private IEnumerable<ModifierOption> GetModifierOptions(Guid modifierId) => Data.ModifierOptions.Where(x => x.ModifierId == modifierId).OrderBy(x => x.SortOrder).ThenBy(x => x.Name);

    private void ProductClicked(Product product)
    {
        var modifiers = GetProductModifiers(product);
        if (!modifiers.Any())
        {
            AddProductToCart(product, new List<SelectedModifier>());
            return;
        }
        SelectedModifierProduct = product;
        SelectedProductModifiers = modifiers;
        SelectedModifierOptions = new Dictionary<Guid, HashSet<Guid>>();
        foreach (var m in modifiers) SelectedModifierOptions[m.Id] = new HashSet<Guid>();
        ShowModifierModal = true;
    }

    private bool IsOptionSelected(Guid modifierId, Guid optionId) => SelectedModifierOptions.TryGetValue(modifierId, out var selected) && selected.Contains(optionId);
    private void SelectModifierOption(Guid modifierId, Guid optionId)
    {
        if (!SelectedModifierOptions.TryGetValue(modifierId, out var selected)) { selected = new HashSet<Guid>(); SelectedModifierOptions[modifierId] = selected; }
        selected.Clear(); selected.Add(optionId);
    }
    private void ToggleModifierOption(Guid modifierId, Guid optionId)
    {
        if (!SelectedModifierOptions.TryGetValue(modifierId, out var selected)) { selected = new HashSet<Guid>(); SelectedModifierOptions[modifierId] = selected; }
        if (selected.Contains(optionId)) selected.Remove(optionId); else selected.Add(optionId);
    }

    private IEnumerable<SelectedModifier> SelectedModifiers
    {
        get
        {
            foreach (var modifier in SelectedProductModifiers)
            {
                if (!SelectedModifierOptions.TryGetValue(modifier.Id, out var optionIds)) continue;
                foreach (var optionId in optionIds)
                {
                    var option = Data.ModifierOptions.FirstOrDefault(x => x.Id == optionId && x.ModifierId == modifier.Id);
                    if (option != null) yield return new SelectedModifier { ModifierId = modifier.Id, ModifierName = modifier.Name, OptionId = option.Id, OptionName = option.Name, Price = option.Price };
                }
            }
        }
    }
    private decimal SelectedModifierTotal => SelectedModifiers.Sum(x => x.Price);
    private decimal ModifierGrandTotal => SelectedModifierProduct is null ? 0 : GetProductPrice(SelectedModifierProduct) + SelectedModifierTotal;

    private void ConfirmModifierProduct()
    {
        if (SelectedModifierProduct is null) return;
        AddProductToCart(SelectedModifierProduct, SelectedModifiers.ToList());
        CloseModifierModal();
    }
    private void CloseModifierModal() { ShowModifierModal = false; SelectedModifierProduct = null; SelectedProductModifiers.Clear(); SelectedModifierOptions.Clear(); }

    // --- POS CART ---
    private void AddProductToCart(Product product, List<SelectedModifier> modifiers)
    {
        decimal unitPrice = GetProductPrice(product) + modifiers.Sum(x => x.Price);
        var existing = Cart.FirstOrDefault(x => x.Product.Id == product.Id && AreModifiersEqual(x.SelectedModifiers, modifiers));
        if (existing is not null) { existing.Quantity++; return; }
        Cart.Add(new CartItem { Product = product, Quantity = 1, UnitPrice = unitPrice, SelectedModifiers = modifiers });
    }
    private bool AreModifiersEqual(List<SelectedModifier> first, List<SelectedModifier> second)
    {
        if (first.Count != second.Count) return false;
        var firstIds = first.Select(x => x.OptionId).OrderBy(x => x).ToList();
        var secondIds = second.Select(x => x.OptionId).OrderBy(x => x).ToList();
        return firstIds.SequenceEqual(secondIds);
    }

    private int CartItemCount => Cart.Sum(x => x.Quantity);
    private decimal Subtotal => Cart.Sum(x => x.UnitPrice * x.Quantity);
    private decimal Discount => Cart.Sum(GetItemDiscountAmount);
    private decimal Tax => 0;
    private decimal Total => Subtotal - Discount + Tax;
    private void IncreaseQuantity(CartItem item) { item.Quantity++; }
    private void DecreaseQuantity(CartItem item) { item.Quantity--; if (item.Quantity <= 0) Cart.Remove(item); }
    private void ClearCart() { Cart.Clear(); }

    // --- POS DISCOUNTS ---
    private void OpenDiscountModal(CartItem item) { DiscountTargetItem = item; PendingDiscountId = item.Discount?.Id; ShowDiscountModal = true; }
    private void CloseDiscountModal() { ShowDiscountModal = false; DiscountTargetItem = null; }
    private void ApplyDiscount() { if (DiscountTargetItem is null) return; DiscountTargetItem.Discount = PendingDiscountId is null ? null : Data.Discounts.FirstOrDefault(x => x.Id == PendingDiscountId.Value); ShowDiscountModal = false; DiscountTargetItem = null; }
    private decimal GetPendingDiscountAmount() { if (DiscountTargetItem is null) return 0m; var discount = PendingDiscountId is null ? null : Data.Discounts.FirstOrDefault(x => x.Id == PendingDiscountId.Value); return GetDiscountAmount(discount, DiscountTargetItem.UnitPrice * DiscountTargetItem.Quantity); }
    private decimal GetItemDiscountAmount(CartItem item) => GetDiscountAmount(item.Discount, item.UnitPrice * item.Quantity);
    private string GetDiscountLabel(Discount discount) { var type = discount.DiscountType.ToString() ?? ""; if (type.Equals("percentage", StringComparison.OrdinalIgnoreCase)) return $"{discount.Value.ToString("N0")}%"; if (type.Equals("fixed_amount", StringComparison.OrdinalIgnoreCase)) return $"-₱{discount.Value.ToString("N2")}"; return ""; }
    private decimal GetDiscountAmount(Discount? discount, decimal baseAmount)
    {
        if (discount is null) return 0m;
        var type = discount.DiscountType.ToString() ?? "";
        decimal amount = type.Equals("percentage", StringComparison.OrdinalIgnoreCase) ? baseAmount * (discount.Value / 100m) : (type.Equals("fixed_amount", StringComparison.OrdinalIgnoreCase) ? discount.Value : 0m);
        return Math.Clamp(amount, 0m, baseAmount);
    }

    // --- POS PAYMENTS (EMBEDDED) ---
    private IEnumerable<PaymentType> ActivePaymentTypes => Data.PaymentTypes.Where(x => x.IsActive).OrderBy(x => x.Name);
    private void SelectDefaultPaymentType() { var first = ActivePaymentTypes.FirstOrDefault(); if (first is not null) SelectPaymentType(first); }
    private void SelectPaymentType(PaymentType paymentType)
    {
        SelectedPaymentTypeId = paymentType.Id;
        SelectedPaymentType = paymentType;
        if (paymentType.Name.ToLower().Contains("cash"))
        {
            CashReceived = Total;
        }
        else
        {
            CashReceived = 0;
        }
    }
    private string GetPaymentIcon(string name) { string value = name.ToLowerInvariant(); if (value.Contains("cash")) return "💵"; if (value.Contains("gcash") || value.Contains("maya")) return "📱"; if (value.Contains("card") || value.Contains("credit") || value.Contains("debit")) return "💳"; if (value.Contains("bank")) return "🏦"; return "💰"; }
    private decimal Change => Math.Max(0, CashReceived - Total);
    private bool CanCompletePayment => SelectedPaymentType is not null && (!SelectedPaymentType.IsCash || CashReceived >= Total);

    private async Task SaveEdit()
    {
        if (!CanCompletePayment || EditingRow is null || SelectedPaymentType is null || !Cart.Any()) return;
        IsSavingEdit = true;
        EditErrorMessage = "";

        try
        {
            var original = EditingRow.Transaction;
            var edited = new Transaction
            {
                Id = Guid.NewGuid(),
                ReceiptId = original.ReceiptId,
                StoreId = original.StoreId,
                TransactionDate = original.TransactionDate,
                GrossSales = Subtotal,
                Refunds = 0,
                Discounts = Discount,
                NetSales = Total,
                Cost = 0,
                GrossProfit = Total,
                Type = original.Type,
                OriginalTransactionId = original.Id,
                CreatedAt = DateTime.UtcNow
            };

            await Data.SaveTransactionAsync(edited);
            Data.Transactions.Add(edited);

            foreach (var cartItem in Cart)
            {
                var transactionItem = new TransactionItem
                {
                    Id = Guid.NewGuid(),
                    TransactionId = edited.Id,
                    ProductId = cartItem.Product.Id,
                    Quantity = cartItem.Quantity,
                    DiscountId = cartItem.Discount?.Id
                };
                var savedItem = await Data.SaveTransactionItemAsync(transactionItem);
                Data.TransactionItems.Add(savedItem);

                foreach (var mod in cartItem.SelectedModifiers)
                {
                    var transactionItemModifier = new TransactionItemModifier
                    {
                        Id = Guid.NewGuid(),
                        TransactionItemId = savedItem.Id,
                        ModifierId = mod.ModifierId,
                        OptionId = mod.OptionId
                    };
                    var savedMod = await Data.SaveTransactionItemModifierAsync(transactionItemModifier);
                    Data.TransactionItemModifiers.Add(savedMod);
                }
            }

            var payment = new TransactionPayment
            {
                Id = Guid.NewGuid(),
                TransactionId = edited.Id,
                PaymentTypeId = SelectedPaymentType.Id,
                PaymentTypeName = SelectedPaymentType.Name,
                Amount = Total,
                CashReceived = SelectedPaymentType.IsCash ? CashReceived : 0,
                ChangeAmount = SelectedPaymentType.IsCash ? Change : 0
            };
            var savedPayment = await Data.SaveTransactionPaymentAsync(payment);
            Data.TransactionPayments.Add(savedPayment);

            ShowEditModal = false;
            EditingRow = null;
            Selected = null;
            Cart.Clear();

            BuildTransactions();
            CurrentPage = 1;
        }
        catch (Exception ex)
        {
            EditErrorMessage = $"Failed to save changes: {ex.Message}";
        }
        finally
        {
            IsSavingEdit = false;
            await InvokeAsync(StateHasChanged);
        }
    }


    // =========================================================
    // REFUND
    // =========================================================

    private async Task RefundTransaction()
{
    if (Selected is null || Selected.Transaction.Type == Transaction.TransactionType.Refunded || IsSuperseded(Selected.Transaction)) return;
    IsRefunding = true;
    ErrorMessage = "";
    
    try
    {
        var original = Selected.Transaction;
        var totals = CalculateTransactionTotals(Selected);

        // 1. Create a new transaction entry for the refund
        var refundTransaction = new Transaction
        {
            Id = Guid.NewGuid(),
            ReceiptId = original.ReceiptId,
            StoreId = original.StoreId,
            TransactionDate = DateTime.UtcNow,
            GrossSales = totals.Gross,
            Refunds = totals.Net, // Sets the refund amount deducted in Net Sales calculations
            Discounts = totals.Discount,
            NetSales = 0,
            Cost = original.Cost,
            GrossProfit = 0,
            Type = Transaction.TransactionType.Refunded,
            OriginalTransactionId = original.Id,
            CreatedAt = DateTime.UtcNow
        };

        // 2. Save the refund transaction
        await Data.SaveTransactionAsync(refundTransaction);
        Data.Transactions.Add(refundTransaction);

        // 3. Copy transaction items over so the refund receipt retains item details
        foreach (var item in Selected.Items)
        {
            var transactionItem = new TransactionItem
            {
                Id = Guid.NewGuid(),
                TransactionId = refundTransaction.Id,
                ProductId = item.ProductId,
                Quantity = item.Quantity,
                DiscountId = item.DiscountId
            };
            var savedItem = await Data.SaveTransactionItemAsync(transactionItem);
            Data.TransactionItems.Add(savedItem);

            // Copy item modifiers if any exist
            var itemMods = Data.TransactionItemModifiers.Where(m => m.TransactionItemId == item.Id).ToList();
            foreach (var mod in itemMods)
            {
                var transactionItemModifier = new TransactionItemModifier
                {
                    Id = Guid.NewGuid(),
                    TransactionItemId = savedItem.Id,
                    ModifierId = mod.ModifierId,
                    OptionId = mod.OptionId
                };
                var savedMod = await Data.SaveTransactionItemModifierAsync(transactionItemModifier);
                Data.TransactionItemModifiers.Add(savedMod);
            }
        }

        Selected = null;
        BuildTransactions();
        CurrentPage = 1;
    }
    catch (Exception ex) 
    { 
        ErrorMessage = $"Failed to refund transaction: {ex.Message}"; 
    }
    finally 
    { 
        IsRefunding = false; 
        await InvokeAsync(StateHasChanged); 
    }
}


