@page "/admin/products"
@rendermode InteractiveServer
@using HolyPOS.Components.Models
@using HolyPOS.Components.Services
@inject NavigationManager Navigation
@using HolyPOS.Components.Misc
@inject DatabaseData Data
@using Microsoft.AspNetCore.Components

@using Microsoft.AspNetCore.Authorization
@using HolyPOS.Components.Layout
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Products</PageTitle>
<LoadingOverlay IsLoading="@IsLoading"
                Message="@LoadingMessage" />
<div class="admin-page">

    <div class="admin-card">
        <PageHeader Head="Products" SubHead="Add items or products to your business" />
        <!-- TOP BAR -->
        <div class="d-flex justify-content-between align-items-start p-4">

            <div class="d-flex align-items-center gap-2">
        
                <button type="button"
                        class="btn btn-primary"
                        @onclick="AddProduct">
                    + ADD ITEM
                </button>

            </div>

            <div class="d-flex gap-4">

                <!-- STORE -->
                <div style="width: 125px;">
                    <label class="form-label text-muted small mb-1">
                        Store
                    </label>

                    <select class="form-select border-0 border-bottom rounded-0 px-0"
                            @bind="SelectedStore">

                        <option value="">All stores</option>

                        @foreach (var store in Stores)
                        {
                            <option value="@store.Key">
                                @store.Value
                            </option>
                        }

                    </select>
                </div>

                <!-- CATEGORY -->
                <div style="width: 125px;">
                    <label class="form-label text-muted small mb-1">
                        Category
                    </label>

                    <select class="form-select border-0 border-bottom rounded-0 px-0"
                            @bind="SelectedCategory">

                        <option value="">All items</option>

                        @foreach (var category in Categories)
                        {
                            <option value="@category.Key">
                                @category.Value
                            </option>
                        }

                    </select>
                </div>

                <div class="d-flex align-items-end pb-2">
                    <button type="button"
                            class="btn btn-link text-secondary p-0">

                        <i class="bi bi-search fs-5"></i>

                    </button>
                </div>

            </div>

        </div>


        <!-- TABLE HEADER -->
        <div class="border-bottom px-4 py-3">
        
            <div class="row align-items-center">
        
                <div class="col-auto" style="width: 55px;">
                    <input type="checkbox"
                           class="form-check-input"
                           style="width:18px;height:18px;" />
                </div>
        
                <div class="col">
                    <button type="button"
                            class="btn btn-link text-dark text-decoration-none p-0"
                            @onclick="() => SortBy(SortColumn.Name)">
                        Item name
                        @GetSortIcon(SortColumn.Name)
                    </button>
                </div>
                
                <div class="col">
                    <button type="button"
                            class="btn btn-link text-dark text-decoration-none p-0"
                            @onclick="() => SortBy(SortColumn.Code)">
                        Item Code
                        @GetSortIcon(SortColumn.Code)
                    </button>
                </div>
        
                <div class="col-3">
                    <button type="button"
                            class="btn btn-link text-dark text-decoration-none p-0"
                            @onclick="() => SortBy(SortColumn.Category)">
                        Category
                        @GetSortIcon(SortColumn.Category)
                    </button>
                </div>
        
                <div class="col-1">
                    <button type="button"
                            class="btn btn-link text-dark text-decoration-none p-0"
                            @onclick="() => SortBy(SortColumn.Price)">
                        Price
                        @GetSortIcon(SortColumn.Price)
                    </button>
                </div>
        
                <div class="col-1">
                    <button type="button"
                            class="btn btn-link text-dark text-decoration-none p-0"
                            @onclick="() => SortBy(SortColumn.Cost)">
                        Cost
                        @GetSortIcon(SortColumn.Cost)
                    </button>
                </div>
        
                <div class="col-1">
                    <button type="button"
                            class="btn btn-link text-dark text-decoration-none p-0"
                            @onclick="() => SortBy(SortColumn.Margin)">
                        Margin
                        @GetSortIcon(SortColumn.Margin)
                    </button>
                </div>
        
                <div class="col-1">
                    <button type="button"
                            class="btn btn-link text-dark text-decoration-none p-0"
                            @onclick="() => SortBy(SortColumn.Stock)">
                        In stock
                        @GetSortIcon(SortColumn.Stock)
                    </button>
                </div>
        
            </div>
        
        </div>


        @foreach (var product in FilteredProducts)
        {
            <div class="border-bottom px-4 py-3">
        
                <div class="row align-items-center">
        
                    <!-- CHECKBOX -->
                    <div class="col-auto"
                         style="width:55px;">
        
                        <input type="checkbox"
                               class="form-check-input"
                               style="width:18px;height:18px;" />
        
                    </div>
        
        
                    <!-- EVERYTHING ELSE IS CLICKABLE -->
                    <div class="col p-0">
        
                        <button type="button"
                                class="product-button w-100 border-0 bg-transparent text-start px-4 py-3"
                                @onclick="() => EditProduct(product.Id.ToString())">
        
                            <div class="row align-items-center">
        
                                <!-- PRODUCT -->
                                <div class="col">
                                    @product.Name
                                </div>
                                
                                <div class="col">
                                    @product.ProductCode
                                </div>
        
                                <!-- CATEGORY -->
                                <div class="col-3">
        
                                    <div class="d-flex align-items-center">
        
                                        <span>
                                            @GetCategoryName(product.CategoryId.ToString())
                                        </span>
        
                                        <i class="bi bi-caret-down-fill text-secondary ms-auto"
                                           style="font-size:10px;">
                                        </i>
        
                                    </div>
        
                                </div>
        
                                <!-- PRICE -->
                                <div class="col-1">
                                    ₱@product.Price.ToString("N2")
                                </div>
        
                                <!-- COST -->
                                <div class="col-1">
                                    ₱@product.Cost.ToString("N2")
                                </div>
        
                                <!-- MARGIN -->
                                <div class="col-1">
                                    @GetMargin(product).ToString("0.##")%
                                </div>
        
                                <!-- STOCK -->
                                <div class="col-1 text-center">
                                    —
                                </div>
        
                            </div>
        
                        </button>
        
                    </div>
        
                </div>
        
            </div>
        }

        <!-- PAGINATION -->
        <div class="d-flex align-items-center p-3">

            <div class="btn-group">

                <button type="button"
                        class="btn btn-outline-secondary">

                    <i class="bi bi-chevron-left"></i>

                </button>

                <button type="button"
                        class="btn btn-outline-secondary">

                    <i class="bi bi-chevron-right"></i>

                </button>

            </div>

            <div class="ms-4 d-flex align-items-center gap-2">

                <span>Page:</span>

                <input type="text"
                       class="form-control text-center"
                       value="1"
                       style="width:40px;"
                       readonly />

                <span>of 1</span>

                <span class="ms-4">
                    Rows per page:
                </span>

                <select class="form-select"
                        style="width:90px;">

                    <option>10</option>
                    <option>25</option>
                    <option>50</option>

                </select>

            </div>

        </div>

    </div>

</div>


@code
{
    
    
    private string SelectedStore = "";
    private string SelectedCategory = "";
    
    protected override async Task OnInitializedAsync()
    {
        await Data.LoadAllAsync();
    }
    
    private IEnumerable<Product> FilteredProducts
{
    get
    {
        IEnumerable<Product> result = Data.Products;

        // ============================================
        // STORE
        // ============================================

        if (!string.IsNullOrEmpty(SelectedStore) &&
            Guid.TryParse(SelectedStore, out var storeId))
        {
            var productIdsForStore = Data.ProductStores
                .Where(x =>
                    x.StoreId == storeId)
                .Select(x => x.ProductId)
                .ToHashSet();

            result = result.Where(product =>
                productIdsForStore.Contains(product.Id));
        }


        // ============================================
        // CATEGORY
        // ============================================

        if (!string.IsNullOrEmpty(SelectedCategory) &&
            Guid.TryParse(SelectedCategory, out var categoryId))
        {
            result = result.Where(product =>
                product.CategoryId == categoryId);
        }


    // ============================================
        // SORT
        // ============================================

        result = CurrentSortColumn switch
        {
            SortColumn.Name =>
                SortAscending
                    ? result.OrderBy(x => x.Name)
                    : result.OrderByDescending(x => x.Name),
            SortColumn.Code =>
                SortAscending
                    ? result.OrderBy(x => x.ProductCode)
                    : result.OrderByDescending(x => x.ProductCode),
            SortColumn.Category =>
                SortAscending
                    ? result.OrderBy(x =>
                        GetCategoryName(x.CategoryId?.ToString()))
                    : result.OrderByDescending(x =>
                        GetCategoryName(x.CategoryId?.ToString())),

            SortColumn.Price =>
                SortAscending
                    ? result.OrderBy(x => x.Price)
                    : result.OrderByDescending(x => x.Price),

            SortColumn.Cost =>
                SortAscending
                    ? result.OrderBy(x => x.Cost)
                    : result.OrderByDescending(x => x.Cost),

            SortColumn.Margin =>
                SortAscending
                    ? result.OrderBy(x => GetMargin(x))
                    : result.OrderByDescending(x => GetMargin(x)),

            SortColumn.Stock =>
                result,

            _ => result
        };

        return result;
    }
}
    
    private bool IsLoading;
    private string LoadingMessage = "Loading...";

    // ============================================================
    // CATEGORIES
    // ============================================================

    private Dictionary<Guid, string> Categories =>
        Data.Categories
            .Where(x => x.IsActive)
            .ToDictionary(
                x => x.Id,
                x => x.Name);


    // ============================================================
    // STORES
    // ============================================================

    private Dictionary<Guid, string> Stores =>
        Data.Stores
            .ToDictionary(
                x => x.Id,
                x => x.Name);


    // ============================================================
    // CATEGORY NAME
    // ============================================================

    private string GetCategoryName(string? categoryId)
    {
        if (string.IsNullOrEmpty(categoryId))
            return "No category";

        if (!Guid.TryParse(categoryId, out var id))
            return "No category";

        return Data.Categories
            .FirstOrDefault(x => x.Id == id)
            ?.Name
            ?? "No category";
    }


    // ============================================================
    // MARGIN
    // ============================================================

    private decimal GetMargin(Product product)
    {
        if (product.Price <= 0)
            return 0;

        return ((product.Price - product.Cost) / product.Price) * 100;
    }


    // ============================================================
    // NAVIGATION
    // ============================================================

    private void AddProduct()
    {
        Navigation.NavigateTo("/admin/products/new");
    }

    private async Task EditProduct(string id)
    {
        if (IsLoading)
            return;

        IsLoading = true;
        LoadingMessage = "Opening product...";

        StateHasChanged();

        await Task.Yield();

        Navigation.NavigateTo($"/admin/products/edit/{id}");
    }
    
    private enum SortColumn
    {
        Name,
        Code,
        Category,
        Price,
        Cost,
        Margin,
        Stock
    }

    private SortColumn CurrentSortColumn = SortColumn.Name;

    private bool SortAscending = true;

    
    private void SortBy(SortColumn column)
    {
        if (CurrentSortColumn == column)
        {
    // Clicking the same column reverses the direction.
            SortAscending = !SortAscending;
        }
        else
        {
    // Clicking a new column starts ascending.
            CurrentSortColumn = column;
            SortAscending = true;
        }
    }
    
    private MarkupString GetSortIcon(SortColumn column)
    {
        if (CurrentSortColumn != column)
            return new MarkupString("");

        return SortAscending
            ? new MarkupString("<span class=\"ms-1\">↑</span>")
            : new MarkupString("<span class=\"ms-1\">↓</span>");
    }
}