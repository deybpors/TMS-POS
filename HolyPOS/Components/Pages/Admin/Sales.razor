    private int GetRowCount()
    {
        return SelectedReport switch
        {
            "Category" =>
                CategoryRows.Count,

            "Item" =>
                ItemRows.Count,

            "Modifier" =>
                ModifierRows.Count,

            "Payment" =>
                PaymentRows.Count,

            _ => 0
        };
    }


