    </div>

</div>


@code
{
    // ============================================================
    // REPORT
    // ============================================================

    private string SelectedReport = "Category";

    private string ReportTitle =>
        SelectedReport switch
        {
            "Category" => "Sales by category",
            "Item" => "Sales by item",
            "Modifier" => "Sales by modifier",
            "Payment" => "Sales by payment type",
            _ => "Sales"
        };


    // ============================================================
    // DATE
    // ============================================================

    private DateTime DateFrom =
        DateTime.Today.AddDays(-29);

    private DateTime DateTo =
        DateTime.Today;


    // ============================================================
    // FILTERS
    // ============================================================

    private string SelectedTime = "All day";

    private string SelectedStore = "";

    private string SelectedEmployee = "";


    // ============================================================
    // STATE
    // ============================================================

    private bool IsLoading;


    // ============================================================
    // REPORT DATA
    // ============================================================

    private List<SalesByCategoryRow> CategoryRows = new();

    private List<SalesByItemRow> ItemRows = new();

    private List<SalesByModifierRow> ModifierRows = new();

    private List<SalesByPaymentRow> PaymentRows = new();


    // ============================================================
    // SORT
    // ============================================================

    private string SortColumn = "";

    private bool SortAscending = true;


    private int CurrentPage = 1;


    // ============================================================
    // INITIALIZE
    // ============================================================

    private string? LoadError;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        LoadError = null;

        try
        {
            await Data.LoadAllAsync();

            LoadSalesReport();
        }
        catch (Exception ex)
        {
            LoadError = ex.ToString();
            Console.WriteLine(ex.ToString());
        }
        finally
        {
            IsLoading = false;
        }
    }


    // ============================================================
    // FILTER CHANGED
    // ============================================================

    private void FiltersChanged()
    {
        if (DateFrom > DateTo)
            return;

        LoadSalesReport();
    }


    // ============================================================
    // DATE RANGE
    // ============================================================

    private Task DateRangeChanged(
        (DateTime Start, DateTime End) range)
    {
        DateFrom = range.Start;

        DateTo = range.End;

        CurrentPage = 1;

        LoadSalesReport();

        return Task.CompletedTask;
    }


    // ============================================================
    // LOAD REPORT
    // ============================================================

    private void LoadSalesReport()
    {
        var filteredTransactions =
            GetFilteredTransactions().ToList();

        // Clear reports that are not currently selected.
        CategoryRows.Clear();
        ItemRows.Clear();
        ModifierRows.Clear();
        PaymentRows.Clear();

        switch (SelectedReport)
        {
            case "Category":
                LoadCategorySales(filteredTransactions);
                break;

            case "Item":
                LoadItemSales(filteredTransactions);
                break;

            case "Modifier":
                LoadModifierSales(filteredTransactions);
                break;

            case "Payment":
                LoadPaymentSales(filteredTransactions);
                break;
        }
    }


    // ============================================================
    // FILTER TRANSACTIONS
    // ============================================================

    private IEnumerable<Transaction> GetFilteredTransactions()
    {
        IEnumerable<Transaction> result =
            Data.Transactions;

        // DATE

        DateTime start =
            DateFrom.Date;

        DateTime end =
            DateTo.Date.AddDays(1);

        result = result.Where(x =>
            x.TransactionDate >= start &&
            x.TransactionDate < end);


        // STORE

        if (!string.IsNullOrWhiteSpace(SelectedStore) &&
            Guid.TryParse(
                SelectedStore,
                out Guid storeId))
        {
            result = result.Where(x =>
                x.StoreId == storeId);
        }


        // EMPLOYEE
        //
        // Currently disabled because transactions
        // does not contain employee_id.


        // TIME

        result = result.Where(MatchesTime);

        return result;
    }


    // ============================================================
    // TIME FILTER
    // ============================================================

    private bool MatchesTime(Transaction transaction)
    {
        if (SelectedTime == "All day")
            return true;

        TimeSpan time =
            transaction.TransactionDate.TimeOfDay;

        return SelectedTime switch
        {
            "Morning" =>
                time >= TimeSpan.FromHours(5) &&
                time < TimeSpan.FromHours(12),

            "Afternoon" =>
                time >= TimeSpan.FromHours(12) &&
                time < TimeSpan.FromHours(18),

            "Evening" =>
                time >= TimeSpan.FromHours(18) &&
                time < TimeSpan.FromHours(24),

            _ => true
        };
    }


    // ============================================================
    // CATEGORY SALES
    // ============================================================

    private void LoadCategorySales(
        List<Transaction> transactions)
    {
        var transactionIds =
            transactions
                .Select(x => x.Id)
                .ToHashSet();

        var transactionLookup =
            transactions.ToDictionary(x => x.Id);

        var productLookup =
            Data.Products.ToDictionary(x => x.Id);

        var categoryLookup =
            Data.Categories.ToDictionary(x => x.Id);

        var discountLookup =
            Data.Discounts.ToDictionary(x => x.Id);


        var items =
            Data.TransactionItems
                .Where(x =>
                    transactionIds.Contains(
                        x.TransactionId))
                .ToList();


        CategoryRows =
            items
                .GroupBy(x =>
                {
                    if (!x.ProductId.HasValue ||
                        !productLookup.TryGetValue(x.ProductId.Value, out var product))
                    {
                        return (Guid?)null;
                    }

                    return product.CategoryId;
                })
                .Select(group =>
                {
                    Guid? categoryId =
                        group.Key;

                    categoryLookup.TryGetValue(
                        categoryId ?? Guid.Empty,
                        out var category);


                    decimal grossSales = 0m;

                    decimal refunds = 0m;

                    decimal discounts = 0m;

                    decimal itemsSold = 0m;

                    decimal itemsRefunded = 0m;


                    foreach (var item in group)
                    {
                        if (!transactionLookup.TryGetValue(
                            item.TransactionId,
                            out var transaction))
                        {
                            continue;
                        }


                        decimal subtotal =
                            Data.GetItemUnitPrice(item) *
                            item.Quantity;


                        decimal discount =
                            CalculateDiscountAmount(
                                item,
                                discountLookup);


                        decimal total =
                            subtotal -
                            discount;


                        var transactionType =
                            transaction.Type;


                        if (transactionType ==
                            Transaction.TransactionType.Sale)
                        {
                            grossSales += subtotal;

                            discounts += discount;

                            itemsSold += item.Quantity;
                        }
                        else if (transactionType ==
                                 Transaction.TransactionType.Refunded)
                        {
                            refunds += total;

                            itemsRefunded +=
                                item.Quantity;
                        }
                    }


                    return new SalesByCategoryRow
                    {
                        CategoryId =
                            categoryId,

                        CategoryName =
                            category?.Name
                            ?? "No category",

                        ItemsSold =
                            itemsSold,

                        GrossSales =
                            grossSales,

                        ItemsRefunded =
                            itemsRefunded,

                        Refunds =
                            refunds,

                        Discounts =
                            discounts
                    };
                })
                .ToList();


        ApplyCategorySort();
    }


    // ============================================================
    // ITEM SALES
    // ============================================================

    private void LoadItemSales(
        List<Transaction> transactions)
    {
        var transactionIds =
            transactions
                .Select(x => x.Id)
                .ToHashSet();

        var transactionLookup =
            transactions.ToDictionary(x => x.Id);

        var productLookup =
            Data.Products.ToDictionary(x => x.Id);

        var categoryLookup =
            Data.Categories.ToDictionary(x => x.Id);

        var discountLookup =
            Data.Discounts.ToDictionary(x => x.Id);


        var items =
            Data.TransactionItems
                .Where(x =>
                    transactionIds.Contains(
                        x.TransactionId))
                .ToList();


        ItemRows =
            items
                .GroupBy(x =>
                    x.ProductId)
                .Select(group =>
                {
                    var first =
                        group.First();


                    Product? product = null;

                    if (first.ProductId.HasValue)
                    {
                        productLookup.TryGetValue(
                            first.ProductId.Value,
                            out product);
                    }


                    var category =
                        product != null &&
                        product.CategoryId.HasValue
                            ? categoryLookup.GetValueOrDefault(
                                product.CategoryId.Value)
                            : null;


                    decimal itemsSold = 0m;

                    decimal grossSales = 0m;

                    decimal refunds = 0m;

                    decimal discounts = 0m;


                    foreach (var item in group)
                    {
                        if (!transactionLookup.TryGetValue(
                            item.TransactionId,
                            out var transaction))
                        {
                            continue;
                        }


                        decimal subtotal =
                            Data.GetItemUnitPrice(item) *
                            item.Quantity;


                        decimal discount =
                            CalculateDiscountAmount(
                                item,
                                discountLookup);


                        decimal total =
                            subtotal -
                            discount;


                        var transactionType =
                            transaction.Type;


                        if (transactionType ==
                            Transaction.TransactionType.Sale)
                        {
                            itemsSold +=
                                item.Quantity;

                            grossSales +=
                                subtotal;

                            discounts +=
                                discount;
                        }
                        else if (transactionType ==
                                 Transaction.TransactionType.Refunded)
                        {
                            refunds += total;
                        }
                    }


                    return new SalesByItemRow
                    {
                        ProductId =
                            first.ProductId,

                        ProductName =
                            product?.Name
                            ?? "Unknown product",

                        CategoryName =
                            category?.Name
                            ?? "No category",

                        ItemsSold =
                            itemsSold,

                        GrossSales =
                            grossSales,

                        Refunds =
                            refunds,

                        Discounts =
                            discounts
                    };
                })
                .ToList();


        ApplyItemSort();
    }


    // ============================================================
    // PAYMENT SALES
    // ============================================================

    private void LoadPaymentSales(
        List<Transaction> transactions)
    {
        var transactionIds =
            transactions
                .Select(x => x.Id)
                .ToHashSet();


        var payments =
            Data.TransactionPayments
                .Where(x =>
                    transactionIds.Contains(
                        x.TransactionId))
                .ToList();


        PaymentRows =
            payments
                .GroupBy(x =>
                    x.PaymentTypeId)
                .Select(group =>
                {
                    var first =
                        group.First();


                    return new SalesByPaymentRow
                    {
                        PaymentTypeId = first.PaymentTypeId,

                        PaymentTypeName = Data.PaymentTypes
                            .FirstOrDefault(x => x.Id == first.PaymentTypeId)?.Name ?? "Unknown Payment Type",

                        Transactions =
                            group
                                .Select(x =>
                                    x.TransactionId)
                                .Distinct()
                                .Count(),

                        GrossSales =
                            group.Sum(x =>
                                x.Amount),

                        Refunds =
                            0m,

                        Discounts =
                            0m
                    };
                })
                .ToList();


        ApplyPaymentSort();
    }


    // ============================================================
    // MODIFIER SALES
    // ============================================================

    private void LoadModifierSales(
        List<Transaction> transactions)
    {
        /*
         * Your current transaction_items table does not
         * contain the modifier that was actually selected.
         *
         * Therefore historical modifier sales cannot
         * currently be calculated from the existing data.
         */

        ModifierRows = new();

        ApplyModifierSort();
    }


    // ============================================================
    // DISCOUNT
    // ============================================================

    private decimal CalculateDiscountAmount(
        TransactionItem item,
        Dictionary<Guid, Discount> discountLookup)
    {
        if (!item.DiscountId.HasValue)
            return 0m;


        if (!discountLookup.TryGetValue(
            item.DiscountId.Value,
            out var discount))
        {
            return 0m;
        }


        decimal subtotal =
            Data.GetItemUnitPrice(item) *
            item.Quantity;


        decimal discountAmount;


        string discountType =
            discount.DiscountType.ToString()
            ?? "";


        if (discountType.Equals(
            "percentage",
            StringComparison.OrdinalIgnoreCase))
        {
            discountAmount =
                subtotal *
                (discount.Value / 100m);
        }
        else if (discountType.Equals(
            "fixed_amount",
            StringComparison.OrdinalIgnoreCase))
        {
            discountAmount =
                discount.Value;
        }
        else
        {
            discountAmount = 0m;
        }


        return Math.Clamp(
            discountAmount,
            0m,
            subtotal);
    }


    // ============================================================
    // CATEGORY SORT
    // ============================================================

    private void SortCategory(string column)
    {
        ToggleSort(column);

        ApplyCategorySort();
    }


    private void ApplyCategorySort()
    {
        CategoryRows =
            SortAscending
                ? CategoryRows
                    .OrderBy(x =>
                        GetCategorySortValue(
                            x,
                            SortColumn))
                    .ToList()
                : CategoryRows
                    .OrderByDescending(x =>
                        GetCategorySortValue(
                            x,
                            SortColumn))
                    .ToList();
    }


    private object GetCategorySortValue(
        SalesByCategoryRow row,
        string column)
    {
        return column switch
        {
            nameof(SalesByCategoryRow.CategoryName) =>
                row.CategoryName,

            nameof(SalesByCategoryRow.ItemsSold) =>
                row.ItemsSold,

            nameof(SalesByCategoryRow.GrossSales) =>
                row.GrossSales,

            nameof(SalesByCategoryRow.ItemsRefunded) =>
                row.ItemsRefunded,

            nameof(SalesByCategoryRow.Refunds) =>
                row.Refunds,

            nameof(SalesByCategoryRow.Discounts) =>
                row.Discounts,

            nameof(SalesByCategoryRow.NetSales) =>
                row.NetSales,

            _ =>
                row.CategoryName
        };
    }


