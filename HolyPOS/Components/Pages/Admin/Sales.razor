@page "/admin/sales"
@rendermode InteractiveServer

@using HolyPOS.Components.Models
@using HolyPOS.Components.Services
@using HolyPOS.Components.Misc
@using HolyPOS.Components.Layout

@inject DatabaseData Data

<PageTitle>Sales</PageTitle>


<LoadingOverlay IsLoading="@IsLoading"
                Message="Loading sales..." />


<div class="admin-page">

    <!-- ======================================================== -->
    <!-- HEADER -->
    <!-- ======================================================== -->

    <div class="page-header">

        <div>

            <h1>Sales</h1>

            <p>
                View and analyze your sales.
            </p>

        </div>

    </div>


    <!-- ======================================================== -->
    <!-- FILTER CARD -->
    <!-- ======================================================== -->

    <div class="admin-card mb-4">

        <div class="p-4">

            <div class="row g-3">


                <!-- REPORT -->

                <div class="col-md-3">

                    <label class="form-label text-muted small">
                        Report
                    </label>

                    <select class="form-select"
                            @bind="SelectedReport"
                            @bind:after="FiltersChanged">

                        <option value="Category">
                            Sales by category
                        </option>

                        <option value="Item">
                            Sales by item
                        </option>

                        <option value="Modifier">
                            Sales by modifier
                        </option>

                        <option value="Payment">
                            Sales by payment type
                        </option>

                    </select>

                </div>
                <DateRangePicker
                StartDate="@DateFrom"
                EndDate="@DateTo"
                OnDateRangeChanged="DateRangeChanged" />
                <!-- TIME -->

                <div class="col-md-2">
                
                    <label class="form-label text-muted small">
                        Time
                    </label>

                    <select class="form-select"
                            @bind="SelectedTime"
                            @bind:after="FiltersChanged">

                        <option value="All day">
                            All day
                        </option>

                        <option value="Morning">
                            Morning
                        </option>

                        <option value="Afternoon">
                            Afternoon
                        </option>

                        <option value="Evening">
                            Evening
                        </option>

                    </select>

                </div>


                <!-- STORE -->

                <div class="col-md-3">

                    <label class="form-label text-muted small">
                        Store
                    </label>

                    <select class="form-select"
                            @bind="SelectedStore"
                            @bind:after="FiltersChanged">

                        <option value="">
                            All stores
                        </option>

                        @foreach (var store in Data.Stores)
                        {
                            <option value="@store.Id">
                                @store.Name
                            </option>
                        }

                    </select>

                </div>
                

            </div>

        </div>

    </div>


    <!-- ======================================================== -->
    <!-- REPORT -->
    <!-- ======================================================== -->

    <div class="admin-card">

        <!-- REPORT HEADER -->

        <div class="d-flex justify-content-between align-items-center p-4">

            <div>

                <h5 class="mb-1">
                    @ReportTitle
                </h5>

                <div class="text-muted small">

                    @DateFrom.ToString("MMM d, yyyy")
                    -
                    @DateTo.ToString("MMM d, yyyy")

                </div>

            </div>


            <div class="text-muted small">

                @GetRowCount() rows

            </div>

        </div>


        <!-- ==================================================== -->
        <!-- CATEGORY -->
        <!-- ==================================================== -->

        @if (SelectedReport == "Category")
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th>
                                <button class="btn btn-link p-0 text-dark text-decoration-none fw-semibold"
                                        @onclick="() => SortCategory(nameof(SalesByCategoryRow.CategoryName))">

                                    Category
                                    @SortIcon(nameof(SalesByCategoryRow.CategoryName))

                                </button>
                            </th>

                            <th class="text-end">
                                Items sold
                            </th>

                            <th class="text-end">
                                Gross sales
                            </th>

                            <th class="text-end">
                                Items refunded
                            </th>

                            <th class="text-end">
                                Refunds
                            </th>

                            <th class="text-end">
                                Discounts
                            </th>

                            <th class="text-end">
                                Net sales
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (!CategoryRows.Any())
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center text-muted py-5">

                                    No sales found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var row in CategoryRows)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @row.CategoryName
                                        </strong>
                                    </td>

                                    <td class="text-end">
                                        @row.ItemsSold.ToString("N0")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.GrossSales.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        @row.ItemsRefunded.ToString("N0")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.Refunds.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.Discounts.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.NetSales.ToString("N2")
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>


                    @if (CategoryRows.Any())
                    {
                        <tfoot>

                            <tr class="table-light fw-semibold">

                                <td>
                                    Total
                                </td>

                                <td class="text-end">
                                    @CategoryRows.Sum(x => x.ItemsSold).ToString("N0")
                                </td>

                                <td class="text-end">
                                    ₱@CategoryRows.Sum(x => x.GrossSales).ToString("N2")
                                </td>

                                <td class="text-end">
                                    @CategoryRows.Sum(x => x.ItemsRefunded).ToString("N0")
                                </td>

                                <td class="text-end">
                                    ₱@CategoryRows.Sum(x => x.Refunds).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@CategoryRows.Sum(x => x.Discounts).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@CategoryRows.Sum(x => x.NetSales).ToString("N2")
                                </td>

                            </tr>

                        </tfoot>
                    }

                </table>

            </div>
        }


        <!-- ==================================================== -->
        <!-- ITEM -->
        <!-- ==================================================== -->

        @if (SelectedReport == "Item")
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th>

                                <button class="btn btn-link p-0 text-dark text-decoration-none fw-semibold"
                                        @onclick="() => SortItem(nameof(SalesByItemRow.ProductName))">

                                    Item
                                    @SortIcon(nameof(SalesByItemRow.ProductName))

                                </button>

                            </th>

                            <th>

                                <button class="btn btn-link p-0 text-dark text-decoration-none fw-semibold"
                                        @onclick="() => SortItem(nameof(SalesByItemRow.CategoryName))">

                                    Category
                                    @SortIcon(nameof(SalesByItemRow.CategoryName))

                                </button>

                            </th>

                            <th class="text-end">
