        }


        <!-- ====================================================== -->
        <!-- MODIFIER -->
        <!-- ====================================================== -->

        @if (SelectedReport == "Modifier")
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th>
                                <button class="btn btn-link p-0 text-dark text-decoration-none fw-semibold"
                                        @onclick="() => SortModifier(nameof(SalesByModifierRow.ModifierName))">

                                    Modifier
                                    @SortIcon(nameof(SalesByModifierRow.ModifierName))

                                </button>
                            </th>

                            <th class="text-end">
                                Quantity
                            </th>

                            <th class="text-end">
                                Gross sales
                            </th>

                            <th class="text-end">
                                Refunds
                            </th>

                            <th class="text-end">
                                Discounts
                            </th>

                            <th class="text-end">
                                Net sales
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (!ModifierRows.Any())
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center text-muted py-5">

                                    No modifier sales found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var row in ModifierRows)
                            {
                                <tr>

                                    <td>
                                        @row.ModifierName
                                    </td>

                                    <td class="text-end">
                                        @row.Quantity.ToString("N0")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.GrossSales.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.Refunds.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.Discounts.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.NetSales.ToString("N2")
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                    @if (ModifierRows.Any())
                    {
                        <tfoot>

                            <tr class="table-light fw-semibold">

                                <td>
                                    Total
                                </td>

                                <td class="text-end">
                                    @ModifierRows.Sum(x => x.Quantity).ToString("N0")
                                </td>

                                <td class="text-end">
                                    ₱@ModifierRows.Sum(x => x.GrossSales).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@ModifierRows.Sum(x => x.Refunds).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@ModifierRows.Sum(x => x.Discounts).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@ModifierRows.Sum(x => x.NetSales).ToString("N2")
                                </td>

                            </tr>

                        </tfoot>
                    }

                </table>

            </div>
        }


        <!-- ====================================================== -->
        <!-- PAYMENT -->
        <!-- ====================================================== -->

        @if (SelectedReport == "Payment")
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th>
                                <button class="btn btn-link p-0 text-dark text-decoration-none fw-semibold"
                                        @onclick="() => SortPayment(nameof(SalesByPaymentRow.PaymentTypeName))">

                                    Payment type
                                    @SortIcon(nameof(SalesByPaymentRow.PaymentTypeName))

                                </button>
                            </th>

                            <th class="text-end">
                                Transactions
                            </th>

                            <th class="text-end">
                                Gross sales
                            </th>

                            <th class="text-end">
                                Refunds
                            </th>

                            <th class="text-end">
                                Discounts
                            </th>

                            <th class="text-end">
                                Net sales
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (!PaymentRows.Any())
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center text-muted py-5">

                                    No payment data found.

                                </td>

                            </tr>
                        }
                        else
