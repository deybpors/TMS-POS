    // ============================================================
    // DISCOUNT CALCULATION
    // ============================================================

    private decimal CalculateDiscountAmount(
        TransactionItem item)
    {
        if (!item.DiscountId.HasValue)
            return 0m;

        var discount =
            Data.Discounts.FirstOrDefault(x =>
                x.Id == item.DiscountId.Value);

        if (discount is null)
            return 0m;

        decimal subtotal =
    Data.GetItemUnitPrice(item) *
    item.Quantity;

        decimal discountAmount;

    // Supabase PostgreSQL enum values:
    // percentage
    // fixed_amount

        string discountType =
            discount.DiscountType.ToString()
            ?? "";

        if (discountType.Equals(
            "percentage",
            StringComparison.OrdinalIgnoreCase))
        {
            discountAmount =
                subtotal *
                (discount.Value / 100m);
        }
        else if (discountType.Equals(
            "fixed_amount",
            StringComparison.OrdinalIgnoreCase))
        {
            discountAmount =
                discount.Value;
        }
        else
        {
            discountAmount = 0m;
        }

    // Never allow the discount to exceed
    // the item's subtotal.

        return Math.Clamp(
            discountAmount,
            0m,
            subtotal);
    }

