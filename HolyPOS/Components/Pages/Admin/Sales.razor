@page "/admin"
@page "/admin/sales"
@rendermode InteractiveServer

@using HolyPOS.Components.Models
@using HolyPOS.Components.Services
@using HolyPOS.Components.Misc
@using HolyPOS.Components.Layout

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@inject DatabaseData Data

<PageTitle>Sales</PageTitle>

<LoadingOverlay IsLoading="@IsLoading"
                Message="Loading sales..." />

<div class="admin-page">
@if (!string.IsNullOrWhiteSpace(LoadError))
{
    <div class="alert alert-danger m-4">
        <h5>Sales page error</h5>

        <pre class="mb-0"
             style="white-space: pre-wrap;">@LoadError</pre>
    </div>
}
<!-- HEADER -->

<PageHeader Head="Sales" SubHead="View and analyze your sales." />

<!-- FILTER BAR -->
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">

        <!-- REPORT -->
        <select class="form-select"
                style="width: 190px;"
                @bind="SelectedReport"
                @bind:after="FiltersChanged">

            <option value="Category">
                Sales by category
            </option>

            <option value="Item">
                Sales by item
            </option>

            <option value="Modifier">
                Sales by modifier
            </option>

            <option value="Payment">
                Sales by payment type
            </option>

        </select>

        <!-- DATE RANGE -->
        <DateRangePicker
            StartDate="@DateFrom"
            EndDate="@DateTo"
            OnDateRangeChanged="DateRangeChanged" />

        <!-- TIME -->
        <select class="form-select"
                style="width: 130px;"
                @bind="SelectedTime"
                @bind:after="FiltersChanged">

            <option value="All day">
                All day
            </option>

            <option value="Morning">
                Morning
            </option>

            <option value="Afternoon">
                Afternoon
            </option>

            <option value="Evening">
                Evening
            </option>

        </select>

        <!-- STORE -->
        <select class="form-select"
                style="width: 150px;"
                @bind="SelectedStore"
                @bind:after="FiltersChanged">

            <option value="">
                All stores
            </option>

            @foreach (var store in Data.Stores)
            {
                <option value="@store.Id">
                    @store.Name
                </option>
            }

        </select>

    </div>

    <!-- REPORT -->
    <div class="admin-card">

        <!-- REPORT HEADER -->
        <div class="d-flex justify-content-between align-items-center p-4">

            <div>
                <h5 class="mb-1">
                    @ReportTitle
                </h5>

                <div class="text-muted small">
                    @DateFrom.ToString("MMM d, yyyy")
                    -
                    @DateTo.ToString("MMM d, yyyy")
                </div>
            </div>

            <div class="text-muted small">
                @GetRowCount() rows
            </div>

        </div>


        <!-- ====================================================== -->
        <!-- CATEGORY -->
        <!-- ====================================================== -->

        @if (SelectedReport == "Category")
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>
                        <tr>

                            <th>
                                <button class="btn btn-link p-0 text-dark text-decoration-none fw-semibold"
                                        @onclick="() => SortCategory(nameof(SalesByCategoryRow.CategoryName))">

                                    Category
                                    @SortIcon(nameof(SalesByCategoryRow.CategoryName))

                                </button>
                            </th>

                            <th class="text-end">
                                Items sold
                            </th>

                            <th class="text-end">
                                Gross sales
                            </th>

                            <th class="text-end">
                                Items refunded
                            </th>

                            <th class="text-end">
                                Refunds
                            </th>

                            <th class="text-end">
                                Discounts
                            </th>

                            <th class="text-end">
                                Net sales
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                        @if (!CategoryRows.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-5">

                                    No sales found.

                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in CategoryRows)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @row.CategoryName
                                        </strong>
                                    </td>

                                    <td class="text-end">
                                        @row.ItemsSold.ToString("N0")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.GrossSales.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        @row.ItemsRefunded.ToString("N0")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.Refunds.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.Discounts.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.NetSales.ToString("N2")
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                    @if (CategoryRows.Any())
                    {
                        <tfoot>

                            <tr class="table-light fw-semibold">

                                <td>
                                    Total
                                </td>

                                <td class="text-end">
                                    @CategoryRows.Sum(x => x.ItemsSold).ToString("N0")
                                </td>

                                <td class="text-end">
                                    ₱@CategoryRows.Sum(x => x.GrossSales).ToString("N2")
                                </td>

                                <td class="text-end">
                                    @CategoryRows.Sum(x => x.ItemsRefunded).ToString("N0")
                                </td>

                                <td class="text-end">
                                    ₱@CategoryRows.Sum(x => x.Refunds).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@CategoryRows.Sum(x => x.Discounts).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@CategoryRows.Sum(x => x.NetSales).ToString("N2")
                                </td>

                            </tr>

                        </tfoot>
                    }

                </table>

            </div>
        }


