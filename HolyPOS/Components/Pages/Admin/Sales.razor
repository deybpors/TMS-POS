    private void ToggleSort(string column)
    {
        if (SortColumn == column)
        {
            SortAscending =
                !SortAscending;
        }
        else
        {
            SortColumn = column;

            SortAscending = true;
        }
    }


    // ============================================================
    // SORT ICON
    // ============================================================

    private RenderFragment SortIcon(
        string column) => builder =>
    {
        if (SortColumn != column)
            return;


        builder.OpenElement(
            0,
            "i");

        builder.AddAttribute(
            1,
            "class",
            SortAscending
                ? "bi bi-arrow-up ms-1"
                : "bi bi-arrow-down ms-1");

        builder.CloseElement();
    };


