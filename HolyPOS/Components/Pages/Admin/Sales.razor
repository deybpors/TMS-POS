                            </th>

                            <th class="text-end">
                                Gross sales
                            </th>

                            <th class="text-end">
                                Refunds
                            </th>

                            <th class="text-end">
                                Discounts
                            </th>

                            <th class="text-end">
                                Net sales
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (!ItemRows.Any())
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center text-muted py-5">

                                    No sales found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var row in ItemRows)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            @row.ProductName
                                        </strong>
                                    </td>

                                    <td>
                                        @row.CategoryName
                                    </td>

                                    <td class="text-end">
                                        @row.ItemsSold.ToString("N0")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.GrossSales.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.Refunds.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.Discounts.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.NetSales.ToString("N2")
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>


                    @if (ItemRows.Any())
                    {
                        <tfoot>

                            <tr class="table-light fw-semibold">

                                <td colspan="2">
                                    Total
                                </td>

                                <td class="text-end">
                                    @ItemRows.Sum(x => x.ItemsSold).ToString("N0")
                                </td>

                                <td class="text-end">
                                    ₱@ItemRows.Sum(x => x.GrossSales).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@ItemRows.Sum(x => x.Refunds).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@ItemRows.Sum(x => x.Discounts).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@ItemRows.Sum(x => x.NetSales).ToString("N2")
                                </td>

                            </tr>

                        </tfoot>
                    }

                </table>

            </div>
        }


        <!-- ==================================================== -->
        <!-- MODIFIER -->
        <!-- ==================================================== -->

        @if (SelectedReport == "Modifier")
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th>

                                <button class="btn btn-link p-0 text-dark text-decoration-none fw-semibold"
                                        @onclick="() => SortModifier(nameof(SalesByModifierRow.ModifierName))">

                                    Modifier
                                    @SortIcon(nameof(SalesByModifierRow.ModifierName))

                                </button>

                            </th>

                            <th class="text-end">
                                Quantity
                            </th>

                            <th class="text-end">
                                Gross sales
                            </th>

                            <th class="text-end">
                                Refunds
                            </th>

                            <th class="text-end">
                                Discounts
                            </th>

                            <th class="text-end">
                                Net sales
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (!ModifierRows.Any())
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center text-muted py-5">

                                    No modifier sales found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var row in ModifierRows)
                            {
                                <tr>

                                    <td>
                                        @row.ModifierName
                                    </td>

                                    <td class="text-end">
                                        @row.Quantity.ToString("N0")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.GrossSales.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.Refunds.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.Discounts.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.NetSales.ToString("N2")
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>


                    @if (ModifierRows.Any())
                    {
                        <tfoot>

                            <tr class="table-light fw-semibold">

                                <td>
                                    Total
                                </td>

                                <td class="text-end">
                                    @ModifierRows.Sum(x => x.Quantity).ToString("N0")
                                </td>

                                <td class="text-end">
                                    ₱@ModifierRows.Sum(x => x.GrossSales).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@ModifierRows.Sum(x => x.Refunds).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@ModifierRows.Sum(x => x.Discounts).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@ModifierRows.Sum(x => x.NetSales).ToString("N2")
                                </td>

                            </tr>

                        </tfoot>
                    }

                </table>

            </div>
        }


        <!-- ==================================================== -->
        <!-- PAYMENT -->
        <!-- ==================================================== -->

        @if (SelectedReport == "Payment")
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th>

                                <button class="btn btn-link p-0 text-dark text-decoration-none fw-semibold"
                                        @onclick="() => SortPayment(nameof(SalesByPaymentRow.PaymentTypeName))">

                                    Payment type
                                    @SortIcon(nameof(SalesByPaymentRow.PaymentTypeName))

                                </button>

                            </th>

                            <th class="text-end">
                                Transactions
                            </th>

                            <th class="text-end">
                                Gross sales
                            </th>

                            <th class="text-end">
                                Refunds
                            </th>

                            <th class="text-end">
                                Discounts
                            </th>

                            <th class="text-end">
                                Net sales
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (!PaymentRows.Any())
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center text-muted py-5">

                                    No payment data found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            @foreach (var row in PaymentRows)
                            {
                                <tr>

                                    <td>
                                        @row.PaymentTypeName
                                    </td>

                                    <td class="text-end">
                                        @row.Transactions.ToString("N0")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.GrossSales.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.Refunds.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.Discounts.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₱@row.NetSales.ToString("N2")
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>


                    @if (PaymentRows.Any())
                    {
                        <tfoot>

                            <tr class="table-light fw-semibold">

                                <td>
                                    Total
                                </td>

                                <td class="text-end">
                                    @PaymentRows.Sum(x => x.Transactions).ToString("N0")
                                </td>

                                <td class="text-end">
                                    ₱@PaymentRows.Sum(x => x.GrossSales).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@PaymentRows.Sum(x => x.Refunds).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@PaymentRows.Sum(x => x.Discounts).ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₱@PaymentRows.Sum(x => x.NetSales).ToString("N2")
                                </td>

                            </tr>

                        </tfoot>
                    }

                </table>

            </div>
        }

    </div>

</div>


@code
{
    // ============================================================
    // REPORT
    // ============================================================

    private string SelectedReport = "Category";

    private string ReportTitle =>
        SelectedReport switch
        {
            "Category" => "Sales by category",
            "Item" => "Sales by item",
            "Modifier" => "Sales by modifier",
            "Payment" => "Sales by payment type",
            _ => "Sales"
        };


    // ============================================================
    // DATE
    // ============================================================

    private DateTime DateFrom =
        DateTime.Today.AddDays(-29);

    private DateTime DateTo =
        DateTime.Today;


    // ============================================================
    // FILTERS
    // ============================================================

    private string SelectedTime = "All day";

    private string SelectedStore = "";

    private string SelectedEmployee = "";


    // ============================================================
    // STATE
    // ============================================================

    private bool IsLoading;


    // ============================================================
    // REPORT DATA
    // ============================================================

    private List<SalesByCategoryRow> CategoryRows = new();

    private List<SalesByItemRow> ItemRows = new();

    private List<SalesByModifierRow> ModifierRows = new();

    private List<SalesByPaymentRow> PaymentRows = new();


    // ============================================================
    // SORT
    // ============================================================

    private string SortColumn = "";

    private bool SortAscending = true;


    // ============================================================
    // INITIALIZE
    // ============================================================

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;

        try
        {
            await Data.LoadAllAsync();

            await LoadSalesReport();
        }
        finally
        {
            IsLoading = false;
        }
    }


    // ============================================================
    // FILTER CHANGED
    // ============================================================

    private async Task FiltersChanged()
    {
        if (DateFrom > DateTo)
            return;

        await LoadSalesReport();
    }


    // ============================================================
    // LOAD REPORT
    // ============================================================

    private Task LoadSalesReport()
    {
        DateTime startDate = DateFrom.Date;
        DateTime endDate = DateTo.Date.AddDays(1);

        var filteredTransactions = Data.Transactions
            .Where(x =>
                x.TransactionDate >= startDate &&
                x.TransactionDate < endDate)
            .ToList();

        switch (SelectedReport)
        {
            case "Category":
                LoadCategorySales(filteredTransactions);
                break;

            case "Item":
                LoadItemSales(filteredTransactions);
                break;

            case "Modifier":
                LoadModifierSales(filteredTransactions);
                break;

            case "Payment":
                LoadPaymentSales(filteredTransactions);
                break;
        }

        return Task.CompletedTask;
    }


    // ============================================================
    // FILTER TRANSACTIONS
    // ============================================================

    private IEnumerable<Transaction> GetFilteredTransactions()
    {
        IEnumerable<Transaction> result =
            Data.Transactions;


        // ========================================================
        // DATE
        // ========================================================

        DateTime start =
            DateFrom.Date;

        DateTime end =
            DateTo.Date.AddDays(1);


        result = result.Where(x =>
            x.TransactionDate >= start &&
            x.TransactionDate < end);


        // ========================================================
        // STORE
        // ========================================================

        if (!string.IsNullOrWhiteSpace(SelectedStore) &&
            Guid.TryParse(
                SelectedStore,
                out Guid storeId))
        {
            result = result.Where(x =>
                x.StoreId == storeId);
        }


        // ========================================================
        // EMPLOYEE
        // ========================================================

        /*
         * Your current transactions table screenshot
         * does NOT contain employee_id.
         *
         * Therefore this filter cannot currently
         * filter anything.
         *
         * Once employee_id is added to transactions,
         * uncomment the following:
         *
         * if (!string.IsNullOrWhiteSpace(SelectedEmployee) &&
         *     Guid.TryParse(SelectedEmployee, out var employeeId))
         * {
         *     result = result.Where(x =>
         *         x.EmployeeId == employeeId);
         * }
         */


        // ========================================================
        // TIME
        // ========================================================

        result = result.Where(MatchesTime);


        return result;
    }


    // ============================================================
    // TIME FILTER
    // ============================================================

    private bool MatchesTime(Transaction transaction)
    {
        if (SelectedTime == "All day")
            return true;


        TimeSpan time =
            transaction.TransactionDate.TimeOfDay;


        return SelectedTime switch
        {
            "Morning" =>
                time >= TimeSpan.FromHours(5) &&
                time < TimeSpan.FromHours(12),

            "Afternoon" =>
                time >= TimeSpan.FromHours(12) &&
                time < TimeSpan.FromHours(18),

            "Evening" =>
                time >= TimeSpan.FromHours(18) &&
                time < TimeSpan.FromHours(24),

            _ => true
        };
    }


    // ============================================================
    // CATEGORY SALES
    // ============================================================

    // ============================================================
// CATEGORY SALES
// ============================================================

private void LoadCategorySales(
    List<Transaction> transactions)
{
    var transactionIds =
        transactions
            .Select(x => x.Id)
            .ToHashSet();


    var transactionLookup =
        transactions.ToDictionary(
            x => x.Id);


    var items =
        Data.TransactionItems
            .Where(x =>
                transactionIds.Contains(
                    x.TransactionId))
            .ToList();


    CategoryRows =
        items
            .GroupBy(x =>
            {
                var product =
                    Data.Products.FirstOrDefault(
                        p => p.Id == x.ProductId);

                return product?.CategoryId;
            })
            .Select(group =>
            {
                Guid? categoryId =
                    group.Key;


                var category =
                    categoryId.HasValue
                        ? Data.Categories.FirstOrDefault(
                            x =>
                                x.Id ==
                                categoryId.Value)
                        : null;


                decimal grossSales = 0m;

                decimal refunds = 0m;

                decimal discounts = 0m;

                decimal itemsSold = 0m;

                decimal itemsRefunded = 0m;


                foreach (var item in group)
                {
                    if (!transactionLookup.TryGetValue(
                        item.TransactionId,
                        out var transaction))
                    {
                        continue;
                    }


                    decimal subtotal =
    Data.GetItemUnitPrice(item) *
    item.Quantity;


                    decimal discount =
                        CalculateDiscountAmount(
                            item);


                    decimal total =
                        subtotal -
                        discount;


                    bool isRefund =
                        transaction.IsRefunded;


                    // =========================================
                    // SALE
                    // =========================================

                    if (!isRefund)
                    {
                        grossSales +=
                            subtotal;

                        discounts +=
                            discount;

                        itemsSold +=
                            item.Quantity;
                    }


                    // =========================================
                    // REFUND
                    // =========================================

                    else
                    {
                        refunds +=
                            total;

                        itemsRefunded +=
                            item.Quantity;
                    }
                }


                return new SalesByCategoryRow
                {
                    CategoryId =
                        categoryId,

                    CategoryName =
                        category?.Name
                        ?? "No category",

                    ItemsSold =
                        itemsSold,

                    GrossSales =
                        grossSales,

                    ItemsRefunded =
                        itemsRefunded,

                    Refunds =
                        refunds,

                    Discounts =
                        discounts
                };
            })
            .ToList();


    ApplyCategorySort();
}


    // ============================================================
    // ITEM SALES
    // ============================================================

    // ============================================================
// ITEM SALES
// ============================================================

private void LoadItemSales(
    List<Transaction> transactions)
{
    var transactionIds =
        transactions
            .Select(x => x.Id)
            .ToHashSet();


    var transactionLookup =
        transactions.ToDictionary(
            x => x.Id);


    var items =
        Data.TransactionItems
            .Where(x =>
                transactionIds.Contains(
                    x.TransactionId))
            .ToList();


    ItemRows =
        items
            .GroupBy(x =>
                x.ProductId)
            .Select(group =>
            {
                var first =
                    group.First();


                var product =
                    first.ProductId.HasValue
                        ? Data.Products.FirstOrDefault(
                            x =>
                                x.Id ==
                                first.ProductId.Value)
                        : null;


                var category =
                    product?.CategoryId is Guid categoryId
                        ? Data.Categories.FirstOrDefault(
                            x =>
                                x.Id ==
                                categoryId)
                        : null;


                decimal itemsSold = 0m;

                decimal grossSales = 0m;

                decimal refunds = 0m;

                decimal discounts = 0m;


                foreach (var item in group)
                {
                    if (!transactionLookup.TryGetValue(
                        item.TransactionId,
                        out var transaction))
                    {
                        continue;
                    }


                    decimal subtotal =
    Data.GetItemUnitPrice(item) *
    item.Quantity;


                    decimal discount =
                        CalculateDiscountAmount(
                            item);


                    decimal total =
                        subtotal -
                        discount;


                    bool isRefund = transaction.IsRefunded;


                    // =========================================
                    // SALE
                    // =========================================

                    if (!isRefund)
                    {
                        itemsSold +=
                            item.Quantity;

                        grossSales +=
                            subtotal;

                        discounts +=
                            discount;
                    }


                    // =========================================
                    // REFUND
                    // =========================================

                    else
                    {
                        refunds +=
                            total;
                    }
                }


                return new SalesByItemRow
                {
                    ProductId =
                        first.ProductId,

                    CategoryName =
                        category?.Name
                        ?? "No category",

                    ItemsSold =
                        itemsSold,

                    GrossSales =
                        grossSales,

                    Refunds =
                        refunds,

                    Discounts =
                        discounts
                };
            })
            .ToList();


    ApplyItemSort();
}


    // ============================================================
    // PAYMENT SALES
    // ============================================================

    private void LoadPaymentSales(List<Transaction> transactions)
    {
        var transactionIds =
            transactions
                .Select(x => x.Id)
                .ToHashSet();


        var payments =
            Data.TransactionPayments
                .Where(x =>
                    transactionIds.Contains(
                        x.TransactionId))
                .ToList();


        PaymentRows =
            payments
                .GroupBy(x =>
                    x.PaymentTypeId)
                .Select(group =>
                {
                    var first =
                        group.First();


                    return new SalesByPaymentRow
                    {
                        PaymentTypeId =
                            first.PaymentTypeId,

                        PaymentTypeName =
                            first.PaymentTypeName,

                        Transactions =
                            group
                                .Select(x =>
                                    x.TransactionId)
                                .Distinct()
                                .Count(),

                        GrossSales =
                            group.Sum(x =>
                                x.Amount),

                        Refunds =
                            0,

                        Discounts =
                            0
                    };
                })
                .ToList();


        /*
         * Payment totals come from transaction_payments.
         *
         * Discounts/refunds belong to the transaction,
         * not the payment itself.
         *
         * If you allow split payments, distributing
         * discounts/refunds between payment types requires
         * an allocation rule.
         */


        ApplyPaymentSort();
    }


