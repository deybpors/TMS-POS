@page "/admin"
@page "/admin/dashboard"

<PageTitle>Admin Dashboard</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <div>
            <h1>Dashboard</h1>
            <p>Overview of your business sales.</p>
        </div>
        <a class="admin-btn primary" href="/admin/sales-summary">View Sales</a>
    </div>

    <div class="stats-grid">
        <div class="stat-card"><span>Gross Sales</span><strong>₱52,400.00</strong></div>
        <div class="stat-card"><span>Refunds</span><strong>₱1,200.00</strong></div>
        <div class="stat-card"><span>Discounts</span><strong>₱2,400.00</strong></div>
        <div class="stat-card"><span>Net Sales</span><strong>₱48,800.00</strong></div>
        <div class="stat-card"><span>Gross Profit</span><strong>₱29,800.00</strong></div>
        <div class="stat-card"><span>Transactions</span><strong>184</strong></div>
    </div>

    <div class="admin-card">
        <div class="card-header"><h2>Quick Links</h2></div>
        <div class="quick-grid">
            <a href="/admin/products">Products</a>
            <a href="/admin/categories">Categories</a>
            <a href="/admin/modifiers">Modifiers</a>
            <a href="/admin/discounts">Discounts</a>
            <a href="/admin/payment-types">Payment Types</a>
            <a href="/admin/stores">Stores</a>
            <a href="/admin/transactions">Transactions</a>
        </div>
    </div>
</div>